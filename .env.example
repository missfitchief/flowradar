# Postgres connection string. LITE mode default (embedded-postgres, port 5439); FULL mode (docker compose) uses port 5432.
DATABASE_URL=postgresql://flowradar:flowradar@localhost:5439/flowradar

# Redis connection string. Empty = LITE mode (no Redis needed, in-process InlineRunner). Set for FULL mode (BullMQ).
REDIS_URL=

# When true, all providers serve the deterministic mock world instead of live APIs.
MOCK_MODE=true

# Port the Next.js dashboard listens on.
WEB_PORT=5188

# Helius API key — Solana wallet activity + risk checks (parsed-transaction-history API).
HELIUS_API_KEY=

# Helius Enhanced-Tx request rate (requests/sec) for wallet-activity polling.
# Default 9 (paid tier). FREE-TIER keys throttle far lower and return 429 at 9
# — set to 1 or 2 for a free key. The adapter also 429-retries with backoff, so
# a too-high value degrades to slow retries rather than failing every poll.
HELIUS_RPS=

# walletActivity per-poll page cap. On a first poll (no cursor) a wallet's full
# history would otherwise be paginated into memory before ingesting; this bounds
# each poll to N pages (newest-first), ingesting per page. Default 5. Older
# history beyond the cap is skipped (logged backfillTruncated) — signals key off
# recent activity. Raise for deeper first-time backfill at the cost of more calls.
WALLET_ACTIVITY_MAX_PAGES=

# Birdeye API key — optional Solana/BSC market data adapter.
BIRDEYE_API_KEY=

# BscScan API key — BSC wallet activity (account/tokentx, account/txlist via
# the unified Etherscan API V2, chainid=56; the legacy api.bscscan.com/api
# endpoint is now rejected server-side). Must be a new Etherscan-issued key,
# not a legacy BscScan-only key. Free tier: ~3 req/sec.
BSCSCAN_API_KEY=

# Moralis API key — optional BSC activity/market data adapter stub.
MORALIS_API_KEY=

# Bitquery API key — optional BSC activity/market data adapter stub.
BITQUERY_API_KEY=

# GoPlus API key — BSC token risk/security checks (token_security endpoint).
# OPTIONAL: this endpoint works keyless at a free tier (live-verified); a key
# only raises rate limits.
GOPLUS_API_KEY=

# Solana Tracker API key — primary Solana smart-wallet PnL leaderboard feeder (Wave 4.5 connector).
SOLANA_TRACKER_API_KEY=

# KOLScan API key — Solana KOL leaderboard feeder, candidate-only until revalidated (Wave 4.5 connector).
# NOTE (Task 36): no official public KOLScan API was found — this adapter ships
# as a typed stub (always returns [], status 'stub') regardless of this key.
KOLSCAN_API_KEY=

# KOLScan API base URL — operator-supplied swap-in point (Task 36). Unset by
# default; the stub adapter reads this but makes no network call under any
# configuration until a real endpoint is verified and wired in.
KOLSCAN_API_BASE=

# GMGN API key — smart-money candidate + cross-check feeder, no hardcoded unofficial endpoints (Wave 4.5 connector).
# NOTE (Task 36): no official public GMGN API was found — this adapter ships
# as a typed stub (always returns [], status 'stub') regardless of this key.
GMGN_API_KEY=

# GMGN API base URL — operator-supplied swap-in point (Task 36). Unset by
# default; the stub adapter reads this but makes no network call under any
# configuration until a real endpoint is verified and wired in.
GMGN_API_BASE=

# Cielo API key — optional PnL-tracker candidate feeder (Wave 4.5 connector).
# NOTE (Task 36): no public REST API reference was found on Cielo's docs site
# (only an in-app "Settings > API key" mention) — this adapter ships as a
# typed stub (always returns [], status 'stub') regardless of this key.
CIELO_API_KEY=

# HolderScan API key — OPTIONAL shadow-only holder-risk confluence provider
# (external-confluence track). Likely paid/plan-gated. Missing key => the
# source reports missing_key and is skipped cleanly; keyed => the adapter is
# still a documented stub (plan_required/unavailable) until real docs/plan
# are confirmed. Holder data being unavailable is NEVER treated as "safe".
HOLDERSCAN_API_KEY=

# CLOBr API key — OPTIONAL shadow-only liquidity-map confluence provider.
# No confirmed public API/docs — the adapter ships as a typed stub (status
# 'stub') regardless of this key; no scraping of gated content.
CLOBR_API_KEY=

# Telegram bot token — used to send alerts via the raw Bot API.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the operator bot.
# Startup fails closed when this is empty or malformed.
TELEGRAM_ALLOWED_USER_IDS=

# Telegram chat ID that receives alerts.
TELEGRAM_CHAT_ID=

# Optional JSON array of additional historical/core token seeds used by the
# unified discovery pipeline. Each item has chain, tokenAddress and source.
FLOWRADAR_CORE_TOKENS_JSON=[]

# Discord webhook URL — alert delivery target (deferred, interface stub only).
DISCORD_WEBHOOK_URL=

# Dune API key — saved-query execution for wallet overlap / token-trader backfill (Wave 4.6).
DUNE_API_KEY=

# Default Dune saved-query ID used by the Overlap Finder's Dune mode.
DUNE_DEFAULT_OVERLAP_QUERY_ID=

# Credit safety: serve the query's latest cached result instead of executing fresh. Default true.
DUNE_USE_LATEST_RESULT=true

# Credit safety: allow fresh (paid) query execution. Off by default — cached-latest only.
DUNE_EXECUTE_FRESH=false
