# Postgres connection string. LITE mode default (embedded-postgres, port 5439); FULL mode (docker compose) uses port 5432.
DATABASE_URL=postgresql://flowradar:flowradar@localhost:5439/flowradar

# Redis connection string. Empty = LITE mode (no Redis needed, in-process InlineRunner). Set for FULL mode (BullMQ).
REDIS_URL=

# When true, all providers serve the deterministic mock world instead of live APIs.
MOCK_MODE=true

# Port the Next.js dashboard listens on.
WEB_PORT=5188

# Helius API key — Solana wallet activity + risk checks (parsed-transaction-history API).
HELIUS_API_KEY=

# Birdeye API key — optional Solana/BSC market data adapter.
BIRDEYE_API_KEY=

# BscScan API key — BSC wallet activity (account/tokentx, account/txlist via
# the unified Etherscan API V2, chainid=56; the legacy api.bscscan.com/api
# endpoint is now rejected server-side). Must be a new Etherscan-issued key,
# not a legacy BscScan-only key. Free tier: ~3 req/sec.
BSCSCAN_API_KEY=

# Moralis API key — optional BSC activity/market data adapter stub.
MORALIS_API_KEY=

# Bitquery API key — optional BSC activity/market data adapter stub.
BITQUERY_API_KEY=

# GoPlus API key — BSC token risk/security checks (token_security endpoint).
# OPTIONAL: this endpoint works keyless at a free tier (live-verified); a key
# only raises rate limits.
GOPLUS_API_KEY=

# Telegram bot token — used to send alerts via the raw Bot API.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID that receives alerts.
TELEGRAM_CHAT_ID=

# Discord webhook URL — alert delivery target (deferred, interface stub only).
DISCORD_WEBHOOK_URL=

# Dune API key — saved-query execution for wallet overlap / token-trader backfill (Wave 4.6).
DUNE_API_KEY=

# Default Dune saved-query ID used by the Overlap Finder's Dune mode.
DUNE_DEFAULT_OVERLAP_QUERY_ID=

# Credit safety: serve the query's latest cached result instead of executing fresh. Default true.
DUNE_USE_LATEST_RESULT=true

# Credit safety: allow fresh (paid) query execution. Off by default — cached-latest only.
DUNE_EXECUTE_FRESH=false
