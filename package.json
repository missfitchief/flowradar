{
  "name": "flowradar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "worker": "npm run dev -w apps/worker",
    "telegram": "npm run dev -w apps/telegram",
    "db:migrate": "npm run db:migrate -w packages/db",
    "db:migrate:new": "npm run db:migrate:new -w packages/db",
    "db:seed": "npm run db:seed -w packages/db",
    "db:studio": "npm run db:studio -w packages/db",
    "backtest:replay": "npm run backtest:replay -w packages/db",
    "lineage:import-roots": "tsx scripts/import-root-wallets.ts",
    "tracker:pilot": "tsx scripts/mass-tracker-pilot.mts",
    "tracker:lineage-pilot": "tsx scripts/mass-tracker-lineage-pilot.mts",
    "tracker:wormhole-pilot": "tsx scripts/wormhole-tracker-pilot.mts",
    "discovery:run": "tsx scripts/operator-discovery.mts",
    "operator:pilot": "tsx scripts/operator-service-pilot.mts",
    "backend:pilot": "tsx scripts/backend-intelligence-pilot.mts",
    "intelligence:pilot": "tsx scripts/intelligence-platform-pilot.mts",
    "intelligence:daemon": "tsx scripts/intelligence-lifecycle-daemon.mts",
    "intelligence:adaptive-pilot": "tsx scripts/adaptive-intelligence-pilot.mts",
    "intelligence:real-outcome-replay": "tsx scripts/adaptive-real-outcome-replay.mts",
    "intelligence:promote-model": "tsx scripts/promote-intelligence-model.mts",
    "intelligence:telegram-smoke": "tsx scripts/adaptive-telegram-smoke.mts",
    "intelligence:import-core-seeds": "tsx scripts/import-priority-core-wallet-seeds.mts",
    "telegram:smoke": "tsx scripts/telegram-smoke.mts",
    "test": "vitest run",
    "typecheck": "tsc -b apps/worker apps/telegram packages/core packages/db packages/providers && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "tsx": "^4.23.0"
  }
}
