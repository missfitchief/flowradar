  tokensUnavailable  Int       @default(0)
  localCandidates    Int       @default(0)
  providerCandidates Int       @default(0)
  walletsObserved    Int       @default(0)
  retryableFailures  Int       @default(0)
  peakHeapBytes      BigInt    @default(0)
  throughputPerSec   Float     @default(0)
  error              String?
  metadataJson       Json

  @@index([startedAt])
  @@index([status])
  @@map("profitable_wallet_discovery_runs")
}

/// Cross-chain entity projection built only from safe evidence: existing
/// probable/strong entities, identical EVM account addresses, and verified
/// official bridge correlations. It is a relationship graph, not identity.
model UnifiedEntity {
  id            String    @id @default(cuid())
  entityKey     String    @unique
  chains        ChainId[]
  memberCount   Int       @default(0)
  confidence    Float
  evidenceJson  Json
  caveats       String[]
  engineVersion Int
  computedAt    DateTime
  createdAt     DateTime  @default(now())
