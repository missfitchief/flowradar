// FlowRadar — Prisma schema
//
// Normative source: docs/superpowers/specs/2026-07-05-flowradar-design.md §4 "Data model".
// 22 models, ordered exactly as spec §4 (section comments below carry the spec numbering).
//
// Precision policy (spec §4):
//   - USD amounts:        Decimal(20,4)
//   - Token amounts:      Decimal(38,18)
//   - Prices:             Decimal(24,12)
//   - Rates/percentages:  Float
//   - Block/slot numbers: BigInt
//   - Enums for chain/action/rule/severity/status/label/node/relationship types.
//   - BSC addresses stored lowercase, rendered checksummed at the UI layer; Solana
//     base58 addresses stored as-is (both are plain String columns here).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum ChainId {
  SOLANA
  ETHEREUM
  BASE
  ARBITRUM
  BSC
}

/// WalletStats.source — where a stats window's numbers ultimately came from.
/// Trust mapping (Phase 0, feat/pre-public-accumulation; see
/// @flowradar/core statsTrustOf): csv=operator_approved,
/// computed=locally_verified, provider=provider_claimed,
/// synthetic=synthetic (reserved for backtest continuations — no writer yet).
enum StatsSource {
  csv
  computed
  provider
  synthetic
}

/// Wallet.status — THE single signal-eligibility gate (Phase 0,
/// feat/pre-public-accumulation). Only 'signal_eligible' wallets can ever
/// count toward early smart-money metrics (enforced at ONE point:
/// @flowradar/core isSignalEligibleStatus inside aggregateWindow's isSmart).
/// public_kol / public_promoter / copytrader feed late-stage crowd-arrival
/// metrics only (Phases 1-3). observation_only wallets are still polled and
/// their activity persisted — they just carry zero signal weight.
enum WalletStatus {
  observation_only
  signal_eligible
  public_kol
  public_promoter
  copytrader
  bot_or_service
  excluded
}

/// WalletClassification.label — 11 values.
/// vocabulary fixed by product brief (Modules 1/5/6)
enum WalletLabel {
  human_like
  smart_money
  whale
  possible_bot
  sniper
  mev
  deployer_related
  copy_trader
  cex_related
  bridge_related
  unknown
}

/// WalletTokenTrade.action
enum TradeAction {
  BUY
  SELL
  TRANSFER_IN
  TRANSFER_OUT
  LP_ADD
  LP_REMOVE
}

/// TokenFlowSnapshot.signalStatus
enum FlowSignalStatus {
  watching
  hot
  profit_rotation
  exit_warning
  dead
}

/// Signal.rule — rules A-G (spec §6 signal rules table).
enum SignalRule {
  A
  B
  C
  D
  E
  F
  G
}

/// Signal.severity / used by BacktestResult context via Signal
enum SignalSeverity {
  INFO
  WATCH
  HIGH
  CRITICAL
}

/// Cluster-intelligence conviction. This is deliberately separate from the
/// legacy A-G signal severity: it is produced only by multi-wallet/entity
/// activation, never by one wallet buying on its own.
enum IntelligenceSignalLevel {
  WATCH
  STRONG_WATCH
  HIGH_CONVICTION
}

/// Alert.type
enum AlertType {
  SIGNAL
  ROTATION
  WALLET_GRAPH
  TEST
}

/// Alert.channel
enum AlertChannel {
  TELEGRAM
  DISCORD
}

/// MoneyFlowEdge.actionType — 11 values.
/// vocabulary fixed by product brief (Modules 1/5/6)
enum MoneyFlowActionType {
  transfer
  swap
  bridge_deposit
  bridge_withdrawal
  cex_deposit
  cex_withdrawal
  dex_buy
  dex_sell
  lp_add
  lp_remove
  contract_interaction
}

/// WalletGraphSearch.mode
enum WalletGraphMode {
  DIRECT
  CAPITAL_FLOW
  ENTITY_DISCOVERY
  FULL_RAW
}

/// WalletGraphSearch.status
enum WalletGraphSearchStatus {
  queued
  running
  done
  failed
  truncated
}

/// WalletGraphNode.nodeType
enum WalletGraphNodeType {
  WALLET
  BRIDGE
  CEX
  ROUTER
  POOL
  TOKEN_CONTRACT
  CONTRACT
  UNKNOWN
}

/// WalletGraphEdge.relationship — 13 values.
/// vocabulary fixed by product brief (Modules 1/5/6)
enum WalletGraphRelationship {
  direct_transfer
  native_transfer
  token_transfer
  stablecoin_transfer
  bridge_deposit
  bridge_withdrawal
  cex_deposit
  cex_withdrawal
  swap_router_interaction
  lp_interaction
  contract_interaction
  deployer_interaction
  unknown
}

/// BacktestResult.horizon
enum BacktestHorizon {
  M15
  H1
  H6
  H24
  D3
  D7
}

/// AddressRegistry.category
enum AddressCategory {
  CEX
  BRIDGE
  ROUTER
  POOL
  DEPLOYER
  MIXER
  TOKEN_CONTRACT
}

/// CandidateWallet.validationStatus — Wave 4.5 connector framework (Task 34/35).
enum CandidateValidationStatus {
  pending
  validating
  promoted
  rejected
}

// ---------------------------------------------------------------------------
// 1. Chain
// ---------------------------------------------------------------------------

model Chain {
  id                 ChainId @id
  name               String
  nativeSymbol       String
  explorerTxUrl      String
  explorerAddressUrl String

  @@map("chains")
}

// ---------------------------------------------------------------------------
// 2. Wallet
// ---------------------------------------------------------------------------

model Wallet {
  id              String       @id @default(cuid())
  address         String
  chain           ChainId
  firstSeenAt     DateTime
  lastActiveAt    DateTime
  isWatched       Boolean      @default(false)
  /// DEPRECATED (Phase 0, feat/pre-public-accumulation): superseded by
  /// status='excluded'. Zero code references existed when status landed;
  /// column kept only to avoid a destructive drop in the same migration.
  isExcluded      Boolean      @default(false)
  exclusionReason String?
  notes           String?
  /// Single signal-eligibility gate — see WalletStatus enum docs. Default
  /// observation_only: a wallet earns eligibility ONLY via operator CSV
  /// import, candidate promotion, or explicit operator action.
  status          WalletStatus @default(observation_only)

  stats                   WalletStats[]
  classifications         WalletClassification[]
  trades                  WalletTokenTrade[]
  clusterLinks            EntityClusterWallet[]
  rotationsAsSource       ProfitRotationSignal[]        @relation("ProfitRotationSource")
  rotationsAsDest         ProfitRotationSignal[]        @relation("ProfitRotationDest")
  /// Reverse side of CandidateWallet.promotedWalletId (Task 34/35 — Wave 4.5).
  promotedFromCandidates  CandidateWallet[]
  /// Capital Lineage Engine (Phase 6a): at most one permanent root record.
  lineageRoot             LineageRoot?
  monitoringSubscriptions MonitoringSubscription[]
  relationshipsAsSender   WalletRelationship[]          @relation("RelationshipSender")
  relationshipsAsReceiver WalletRelationship[]          @relation("RelationshipReceiver")
  observationSnapshots    ObservationProviderSnapshot[]
  intelligenceProfile     WalletIntelligenceProfile?

  @@unique([address, chain])
  @@index([status])
  @@map("wallets")
}

// ---------------------------------------------------------------------------
// 3. WalletStats
// ---------------------------------------------------------------------------

model WalletStats {
  id               String      @id @default(cuid())
  walletId         String
  window           String // e.g. "30d" — fixed rolling-window label, not a bounded enum per spec §4.
  pnlUsd           Decimal     @db.Decimal(20, 4)
  realizedPnlUsd   Decimal     @db.Decimal(20, 4)
  unrealizedPnlUsd Decimal     @db.Decimal(20, 4)
  winRate          Float
  tradeCount       Int
  avgTradeSizeUsd  Decimal     @db.Decimal(20, 4)
  walletScore      Float
  scoreComponents  Json
  pnlConfidence    Float // 0-100
  source           StatsSource
  computedAt       DateTime

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_stats")
}

// ---------------------------------------------------------------------------
// 4. WalletClassification
// ---------------------------------------------------------------------------

model WalletClassification {
  id         String      @id @default(cuid())
  walletId   String
  label      WalletLabel
  confidence Float
  evidence   Json

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_classifications")
}

// ---------------------------------------------------------------------------
// 5. Token
// ---------------------------------------------------------------------------

model Token {
  id             String    @id @default(cuid())
  chain          ChainId
  address        String
  symbol         String
  name           String
  decimals       Int
  pairAddress    String?
  dex            String?
  firstSeenAt    DateTime
  tokenCreatedAt DateTime?
  website        String?
  twitter        String?
  telegram       String?
  riskFlags      Json

  marketSnapshots     TokenMarketSnapshot[]
  trades              WalletTokenTrade[]
  flowSnapshots       TokenFlowSnapshot[]
  signals             Signal[]
  alerts              Alert[]
  sourceRotations     ProfitRotationSignal[]    @relation("ProfitRotationSourceToken")
  destRotations       ProfitRotationSignal[]    @relation("ProfitRotationDestToken")
  socialMentions      SocialMention[]
  /// Task B (External Confluence) — reverse side of TokenConfluenceSnapshot.token.
  /// Shadow-only evidence rows; nullable FK with onDelete: SetNull, so deleting a
  /// Token orphans (never deletes) its confluence snapshots — they keep pointing at
  /// the (chain, tokenAddress) pair. NEVER feeds FlowScore / signals / wallet scoring.
  confluenceSnapshots TokenConfluenceSnapshot[]
  stealthSnapshots    StealthSnapshot[]
  riskSnapshot        TokenRiskSnapshot?

  @@unique([chain, address])
  @@map("tokens")
}

/// StealthSnapshot.state — the shadow accumulation lifecycle (Wave F engine).
enum StealthState {
  WATCHING
  STEALTH_ACCUMULATION
  EARLY_INDEPENDENT_CONFIRMATION
  PUBLIC_KOL_ARRIVAL
  CROWD_EXPANSION
  DISTRIBUTION_RISK
  INVALIDATED
}

/// StealthSnapshot — SHADOW-ONLY persisted output of the pure stealth
/// accumulation engine (packages/core/src/stealth). One row per
/// (token, evaluation bucket); re-running a pass inside the same bucket
/// UPSERTS (replay-idempotent, never duplicates). NOTHING reads this model
/// for FlowScore, signals, thresholds, or eligibility — it is evidence +
/// lifecycle state for operators and later forward-outcome evaluation.
model StealthSnapshot {
  id                  String        @id @default(cuid())
  tokenId             String
  chain               ChainId
  state               StealthState
  /// State of the previous bucket's snapshot (null for the first).
  previousState       StealthState?
  stateChanged        Boolean
  /// 0-100 SHADOW score from the pure engine. NOT a FlowScore.
  stealthScore        Float
  /// Full StealthMetrics object (~27 structural fields), verbatim.
  metrics             Json
  /// Extra evidence components the engine input was built from:
  /// per-window cohort flows, fresh-funded-receiver buyer count,
  /// liquidity/holder/social conflict notes, windows covered.
  evidence            Json
  /// Plain-English one-paragraph explanation of state + why.
  explanation         String
  /// Plain-English invalidation/risk reasons (empty array unless the state
  /// carries risk: DISTRIBUTION_RISK / INVALIDATED / PUBLIC_KOL_ARRIVAL).
  invalidationReasons Json
  /// Evaluation bucket start (computedAt floored to the pass interval) —
  /// the replay-idempotency key component.
  bucketTs            DateTime
  computedAt          DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([tokenId, bucketTs])
  @@index([state, bucketTs])
  @@index([tokenId, computedAt])
  @@map("stealth_snapshots")
}

// ---------------------------------------------------------------------------
// 6. TokenMarketSnapshot
// ---------------------------------------------------------------------------

model TokenMarketSnapshot {
  id           String   @id @default(cuid())
  tokenId      String
  ts           DateTime
  priceUsd     Decimal  @db.Decimal(24, 12)
  marketCapUsd Decimal  @db.Decimal(20, 4)
  fdvUsd       Decimal  @db.Decimal(20, 4)
  liquidityUsd Decimal  @db.Decimal(20, 4)
  vol5m        Decimal  @db.Decimal(20, 4)
  vol1h        Decimal  @db.Decimal(20, 4)
  vol6h        Decimal  @db.Decimal(20, 4)
  vol24h       Decimal  @db.Decimal(20, 4)
  holderCount  Int
  /// Task 40 fix pass — machine-detectable synthetic provenance. 'ingest'
  /// (default) for every real provider-sourced snapshot; snapshotMarket's
  /// callers can pass an explicit override — currently only
  /// seed.ts's seedBacktestContinuation, which writes
  /// 'seed_synthetic_continuation' on every row it creates. runBacktestPass
  /// checks this column to flag BacktestResult rows evaluated over a
  /// synthetic-containing series (see backtest.ts).
  source       String   @default("ingest")

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, ts])
  @@map("token_market_snapshots")
}

// ---------------------------------------------------------------------------
// 7. WalletTokenTrade
// ---------------------------------------------------------------------------

model WalletTokenTrade {
  id                  String      @id @default(cuid())
  walletId            String
  tokenId             String
  chain               ChainId
  action              TradeAction
  amountToken         Decimal     @db.Decimal(38, 18)
  amountUsd           Decimal     @db.Decimal(20, 4)
  txHash              String
  blockOrSlot         BigInt
  ts                  DateTime
  priceUsd            Decimal     @db.Decimal(24, 12)
  marketCapAtTrade    Decimal     @db.Decimal(20, 4)
  /// Honest backfilled valuation (rescue sprint): NULL == unavailable. Only
  /// ever set on rows whose legacy amountUsd was 0-for-unpriced.
  valuedUsd           Decimal?    @db.Decimal(24, 4)
  /// Valuation hierarchy level used (e.g. 'birdeye_1d_prior_close',
  /// 'prior_market_snapshot'). NULL == original ingest pricing.
  valuationSource     String?
  valuationConfidence Float?
  walletScoreAtTime   Float
  entityClusterId     String?
  provider            String

  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  token         Token          @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  entityCluster EntityCluster? @relation(fields: [entityClusterId], references: [id])

  @@unique([chain, txHash, walletId, tokenId, action])
  @@index([valuationSource])
  @@index([walletId])
  @@index([tokenId])
  @@index([entityClusterId])
  @@map("wallet_token_trades")
}

// ---------------------------------------------------------------------------
// 8. TokenFlowSnapshot
// ---------------------------------------------------------------------------

model TokenFlowSnapshot {
  id                         String           @id @default(cuid())
  tokenId                    String
  ts                         DateTime
  windowMinutes              Int
  flowScore                  Float
  smartWalletCount           Int
  humanLikeCount             Int
  possibleBotCount           Int
  uniqueEntityCount          Int
  clusterAdjustedWalletCount Int
  entityConcentrationRisk    Float
  trackedBuyVolumeUsd        Decimal          @db.Decimal(20, 4)
  trackedSellVolumeUsd       Decimal          @db.Decimal(20, 4)
  netFlowUsd                 Decimal          @db.Decimal(20, 4)
  buySellRatio               Float
  avgEntryMcap               Decimal          @db.Decimal(20, 4)
  currentMcap                Decimal          @db.Decimal(20, 4)
  mcapExpansionFromAvgEntry  Float
  holdersGrowth              Float
  liquidityChange            Float
  signalStatus               FlowSignalStatus
  componentBreakdown         Json

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, ts])
  @@index([flowScore])
  @@map("token_flow_snapshots")
}

// ---------------------------------------------------------------------------
// 9. Signal
// ---------------------------------------------------------------------------

model Signal {
  id                String         @id @default(cuid())
  tokenId           String
  rule              SignalRule
  severity          SignalSeverity
  triggeredAt       DateTime
  reasons           Json
  walletCount       Int
  uniqueEntityCount Int
  netFlowUsd        Decimal        @db.Decimal(20, 4)
  mcapAtTrigger     Decimal        @db.Decimal(20, 4)
  status            String
  /// Task 15 addition: rawWalletCount/uniqueEntityCount/largestClusterSize/
  /// entityConcentrationRisk snapshot at trigger time (entityConcentrationRisk
  /// degrades to 'unknown' until Task 22's clustering lands — see
  /// packages/db/src/signals.ts).
  metrics           Json           @default("{}")

  token           Token            @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  alerts          Alert[]
  backtestResults BacktestResult[]

  @@index([severity, triggeredAt])
  @@index([tokenId])
  @@map("signals")
}

// ---------------------------------------------------------------------------
// 10. Alert
// ---------------------------------------------------------------------------

model Alert {
  id               String       @id @default(cuid())
  signalId         String?
  /// Task 23: FK to the ProfitRotationSignal a ROTATION-type Alert renders
  /// (mirrors signalId's role for SIGNAL-type alerts) — lets
  /// dispatchPendingAlerts find "every ProfitRotationSignal with NO Alert
  /// row yet" the same way it already finds pending Signal rows
  /// (`rotationSignal: { alerts: { none: {} } }`), rather than needing an
  /// ad-hoc Json-payload dedupe check.
  rotationSignalId String?
  type             AlertType
  channel          AlertChannel
  tokenId          String?
  rule             SignalRule?
  sentAt           DateTime
  payload          Json
  deliveryStatus   String
  error            String?

  signal         Signal?               @relation(fields: [signalId], references: [id])
  rotationSignal ProfitRotationSignal? @relation(fields: [rotationSignalId], references: [id])
  token          Token?                @relation(fields: [tokenId], references: [id])

  @@index([tokenId, rule, sentAt])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// 11. ProviderSyncState
// ---------------------------------------------------------------------------

model ProviderSyncState {
  id         String    @id @default(cuid())
  provider   String
  chain      ChainId
  scope      String // wallet address | "market" | token identifier
  cursor     String?
  lastSyncAt DateTime?
  lastError  String?
  failCount  Int       @default(0)

  @@unique([provider, chain, scope])
  @@map("provider_sync_states")
}

/// TokenRiskSnapshot.status — the RESULT of the last risk fetch (freshness is
/// DERIVED at read time from observedAt/expiresAt, not stored here).
enum RiskSnapshotStatus {
  ok // holder/supply data fetched, penalty+flags meaningful
  unavailable // honestly unavailable (e.g. mega-holder mint) — penalty 0 is NOT "safe"
  throttled // provider 429 — nextRefreshAt backs off
  error // other provider/RPC error — retried with backoff
}

/// TokenRiskSnapshot — canonical cache of per-token risk (Helius holder/supply
/// checks). Eliminates the per-token, per-cycle live risk calls that
/// flowScoring + entityClustering were each issuing (the 429 burst). The
/// bounded tokenRiskRefresh job is the ONLY writer of live provider data here;
/// scoring/clustering READ this cache. Does NOT change FlowScore: a fresh row
/// returns the exact {penalty, flags} the live call produced.
model TokenRiskSnapshot {
  id            String             @id @default(cuid())
  tokenId       String             @unique
  chain         ChainId
  tokenAddress  String
  provider      String
  /// When a refresh was last ATTEMPTED (success or failure).
  requestedAt   DateTime
  /// When the underlying provider data was OBSERVED (success only). Drives freshness.
  observedAt    DateTime?
  status        RiskSnapshotStatus
  /// RiskReport.flags verbatim (JSON) — reconstructs the exact report on read.
  flags         Json
  /// RiskReport.penalty (0..1) — the ONLY field FlowScore reads.
  penalty       Float
  /// 0..100 confidence in this snapshot (lower when stale/unavailable/derived).
  confidence    Float
  /// Non-null when status != ok — the failure class ('rate_limited'|'mega_holder'|'rpc'|...).
  errorCategory String?
  /// Consecutive failures — drives exponential backoff of nextRefreshAt.
  failCount     Int                @default(0)
  /// Hard freshness edge: after this the cached report is STALE (still usable, labeled).
  expiresAt     DateTime
  /// Earliest time the refresh job should re-fetch this token.
  nextRefreshAt DateTime
  /// Bumped when the risk-computation logic changes (invalidate cache semantics).
  sourceVersion Int                @default(1)
  metadataJson  Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([chain, tokenAddress])
  @@index([nextRefreshAt])
  @@index([status])
  @@map("token_risk_snapshots")
}

// ---------------------------------------------------------------------------
// 12. Settings
// ---------------------------------------------------------------------------

model Settings {
  id        String   @id @default(cuid())
  values    Json // Zod-validated Json of all thresholds (spec §7 defaults)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// 13. ImportJob
// ---------------------------------------------------------------------------

model ImportJob {
  id         String    @id @default(cuid())
  filename   String
  status     String
  totalRows  Int
  okRows     Int
  errorRows  Int
  errors     Json
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// 14. MoneyFlowEdge
// ---------------------------------------------------------------------------

/// MoneyFlowEdge.valuationStatus — HONEST value provenance (Wave A, Capital
/// Lineage). Distinguishes a genuine zero from an unavailable valuation, and
/// a current-price estimate from an exact historical price. `valuedUsd` is
/// NULL whenever status is `unavailable` — never coerced to 0 (hard rule 9).
/// The legacy `amountUsd` column is left untouched for existing FlowScore-path
/// consumers; the lineage/shadow path reads valuedUsd + valuationStatus.
enum ValuationStatus {
  exact_provider_historical
  nearest_prior_snapshot
  stablecoin_nominal
  current_price_estimate
  unavailable
  not_applicable
}

model MoneyFlowEdge {
  id                 String              @id @default(cuid())
  sourceAddress      String
  destinationAddress String
  sourceChain        ChainId
  destinationChain   ChainId
  asset              String
  /// SPL mint address when known (token_transfer); NULL for native SOL. Used
  /// to classify the asset by REGISTRY (not symbol text) during valuation.
  assetMint          String?
  amountToken        Decimal             @db.Decimal(38, 18)
  /// Legacy nominal USD (existing consumers; may be 0 for unpriced). NOT the
  /// honest value — read valuedUsd/valuationStatus for that.
  amountUsd          Decimal             @db.Decimal(20, 4)
  ts                 DateTime
  txHash             String
  actionType         MoneyFlowActionType
  bridgeProtocol     String?
  confidence         Float
  providerSource     String
  metadata           Json

  // --- Honest valuation (Wave A) — all nullable/additive ---
  /// Honest USD value; NULL == unavailable (never 0-for-unknown).
  valuedUsd           Decimal?         @db.Decimal(20, 4)
  /// Unit price used; NULL when unavailable/not_applicable.
  priceUsd            Decimal?         @db.Decimal(24, 12)
  /// Timestamp of the price observation used (never a future time).
  priceTimestamp      DateTime?
  valuationStatus     ValuationStatus?
  /// Provenance of the price (e.g. 'wsol_prior_snapshot', 'stablecoin_registry', 'dexscreener_current').
  valuationSource     String?
  /// 0-100; lower for current-price estimates, higher for exact historical.
  valuationConfidence Float?
  /// Age of the price observation relative to the transfer, seconds.
  valuationAgeSeconds Int?
  valuationReason     String?

  @@unique([txHash, sourceAddress, destinationAddress, actionType])
  @@index([valuationStatus])
  @@index([sourceAddress, ts])
  @@index([destinationAddress, ts])
  @@index([txHash])
  @@index([sourceChain, ts])
  @@map("money_flow_edges")
}

// ---------------------------------------------------------------------------
// 15. EntityCluster
// ---------------------------------------------------------------------------

model EntityCluster {
  id                String    @id @default(cuid())
  confidence        Float
  walletCount       Int
  total30dPnlUsd    Decimal   @db.Decimal(20, 4)
  chains            ChainId[]
  evidence          Json
  mainFundingSource String?
  updatedAt         DateTime  @updatedAt

  wallets EntityClusterWallet[]
  trades  WalletTokenTrade[]

  @@map("entity_clusters")
}

// ---------------------------------------------------------------------------
// 16. EntityClusterWallet
// ---------------------------------------------------------------------------

model EntityClusterWallet {
  id             String @id @default(cuid())
  clusterId      String
  walletId       String
  linkConfidence Float
  evidence       Json

  cluster EntityCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  wallet  Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([clusterId, walletId])
  @@map("entity_cluster_wallets")
}

// ---------------------------------------------------------------------------
// 17. ProfitRotationSignal
// ---------------------------------------------------------------------------

model ProfitRotationSignal {
  id                  String    @id @default(cuid())
  sourceWalletId      String
  destWalletId        String
  sourceTokenId       String
  destTokenId         String
  realizedProfitUsd   Decimal   @db.Decimal(20, 4)
  transferredValueUsd Decimal   @db.Decimal(20, 4)
  chainPath           ChainId[]
  timeGapMin          Float
  confidence          Float
  detectedAt          DateTime
  destTokenMcapAtBuy  Decimal   @db.Decimal(20, 4)
  currentDestPerfPct  Float
  /// The matched candidate's ACTUAL received-value (RotationCandidate.receivedValueUsd,
  /// packages/core/src/rotation/matcher.ts), persisted so the real
  /// receivedValueUsd/transferredValueUsd match% can be displayed later
  /// instead of only the settings floor (Task 43 review fix). Nullable/
  /// additive: legacy rows persisted before this column existed have no way
  /// to backfill this figure, so null is a valid, permanent state for those
  /// rows — display code must treat null as "exact figure unavailable", not
  /// as zero.
  receivedValueUsd    Decimal?  @db.Decimal(20, 4)

  sourceWallet Wallet  @relation("ProfitRotationSource", fields: [sourceWalletId], references: [id], onDelete: Cascade)
  destWallet   Wallet  @relation("ProfitRotationDest", fields: [destWalletId], references: [id], onDelete: Cascade)
  sourceToken  Token   @relation("ProfitRotationSourceToken", fields: [sourceTokenId], references: [id], onDelete: Cascade)
  destToken    Token   @relation("ProfitRotationDestToken", fields: [destTokenId], references: [id], onDelete: Cascade)
  /// Task 23: reverse side of Alert.rotationSignalId — see that field's doc
  /// comment for why this exists (dispatchPendingAlerts' ROTATION dedupe).
  alerts       Alert[]

  @@index([sourceWalletId])
  @@index([destWalletId])
  @@map("profit_rotation_signals")
}

// ---------------------------------------------------------------------------
// 18. WalletGraphSearch
// ---------------------------------------------------------------------------

model WalletGraphSearch {
  id            String                  @id @default(cuid())
  rootAddress   String
  chain         ChainId
  mode          WalletGraphMode
  params        Json
  status        WalletGraphSearchStatus
  nodeCount     Int
  edgeCount     Int
