  completedAt                      DateTime?
  status                           String
  sinceTs                          DateTime
  trackedWallets                   Int       @default(0)
  newBuyEvents                     Int       @default(0)
  tokensConsidered                 Int       @default(0)
  alertsCreated                    Int       @default(0)
  historicalWithoutActivitySkipped Int       @default(0)
  errorCount                       Int       @default(0)
  metadataJson                     Json

  @@index([startedAt])
  @@index([status])
  @@map("tracked_activation_scan_runs")
}

/// Persisted operator watchlist. Telegram user/chat ids are decimal strings so
/// no JavaScript-number or database-width truncation can occur.
model OperatorWatch {
  id         String   @id @default(cuid())
  userId     String
  chatId     String
  targetType String
  targetKey  String
  chain      ChainId?
  alertTypes String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  alerts OperatorWatchAlert[]

  @@unique([userId, chatId, targetType, targetKey])
  @@index([active, updatedAt])
  @@map("operator_watches")
}

model OperatorWatchAlert {
  id          String    @id @default(cuid())
  watchId     String
  eventKey    String
  alertType   String
  payloadJson Json
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  lastError   String?

  watch OperatorWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, eventKey, alertType])
  @@index([status, createdAt])
  @@map("operator_watch_alerts")
}

/// Short-lived persisted callback state keeps Telegram callback_data bounded
/// to 64 bytes and makes pagination restart-safe.
model OperatorSession {
  id        String   @id @default(cuid())
  userId    String
  chatId    String
  workflow  String
  stateJson Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
  @@map("operator_sessions")
}

/// Long-poll offset only. The bot token is never persisted.
model TelegramBotCursor {
  botKey       String   @id
  nextUpdateId BigInt   @default(0)
  updatedAt    DateTime @updatedAt

  @@map("telegram_bot_cursors")
}

/// Canonical persisted wallet investigation. Every Telegram wallet/entity/
/// flow/bridge view reads this snapshot instead of running an independent
/// lookup. Investigation evidence is observation-only.
model WalletInvestigation {
  id                   String    @id @default(cuid())
  investigationKey     String    @unique
  rootAddress          String
  addressKind          String
  maxDepth             Int
  status               String
  entityKey            String?
  coverageStatus       String
  summaryJson          Json
  providerReceiptsJson Json
  startedAt            DateTime
  completedAt          DateTime?
  lastRefreshAt        DateTime?
  lastError            String?
  engineVersion        Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  chains      WalletInvestigationChainCoverage[]
  paths       WalletInvestigationPath[]
  members     WalletInvestigationMember[]
  deployments WalletInvestigationDeployment[]

  @@index([rootAddress, completedAt])
  @@index([entityKey, completedAt])
  @@index([status, updatedAt])
  @@map("wallet_investigations")
}

model WalletInvestigationChainCoverage {
  id              String    @id @default(cuid())
  investigationId String
  chain           ChainId
  activityFound   Boolean   @default(false)
  firstActivityAt DateTime?
  lastActivityAt  DateTime?
  eventsScanned   Int       @default(0)
  coverageStatus  String
  provider        String?
  warnings        String[]
  receiptsJson    Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  investigation WalletInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@unique([investigationId, chain])
  @@index([chain, activityFound])
  @@map("wallet_investigation_chain_coverage")
}

model WalletInvestigationPath {
  id                        String   @id @default(cuid())
  investigationId           String
  pathKey                   String
  routeType                 String
  sourceChain               ChainId
  sourceAddress             String
  destinationChain          ChainId
  destinationAddress        String
  assetAddress              String?
  assetSymbol               String?
  amountToken               String?
  amountUsd                 Decimal? @db.Decimal(24, 4)
  valueStatus               String
  eventTs                   DateTime
  txHash                    String?
  protocol                  String?
  evidenceTier              String
  confidence                Float
  hopCount                  Int
  hopsJson                  Json
  supportingEvidenceJson    Json
  contradictingEvidenceJson Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  investigation WalletInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@unique([investigationId, pathKey])
  @@index([investigationId, eventTs])
  @@index([investigationId, routeType, eventTs])
  @@index([destinationChain, destinationAddress])
  @@map("wallet_investigation_paths")
}

model WalletInvestigationMember {
  id                        String   @id @default(cuid())
  investigationId           String
  chain                     ChainId
  address                   String
  role                      String
  parentChain               ChainId?
  parentAddress             String?
  entityKey                 String?
  relationshipConfidence    Float
  evidenceTier              String
  supportingEvidenceJson    Json
  contradictingEvidenceJson Json
  firstLinkedAt             DateTime
  lastLinkedAt              DateTime
  observationOnly           Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  investigation WalletInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@unique([investigationId, chain, address])
  @@index([entityKey, relationshipConfidence])
  @@index([chain, address])
  @@map("wallet_investigation_members")
}

model WalletInvestigationDeployment {
  id                   String   @id @default(cuid())
  investigationId      String
  deploymentKey        String
  chain                ChainId
  buyerAddress         String
  tokenAddress         String
  tokenSymbol          String?
  buyTs                DateTime
  buyTxHash            String
  amountToken          String?
  amountUsd            Decimal? @db.Decimal(24, 4)
  entryMarketCapUsd    Decimal? @db.Decimal(24, 4)
  fundingToBuyDelaySec Int?
  sourceEntityKey      String?
  capitalRouteJson     Json
  holdingStatus        String
  evidenceTier         String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  investigation WalletInvestigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@unique([investigationId, deploymentKey])
  @@index([chain, tokenAddress, buyTs])
  @@index([buyerAddress, buyTs])
  @@map("wallet_investigation_deployments")
}

/// Stable, accumulating intelligence cluster. A cluster is never deleted when
/// new evidence changes its membership: superseded clusters are retained with
/// status='merged' and an append-only IntelligenceClusterMerge receipt.
model IntelligenceCluster {
  id                String   @id @default(cuid())
  clusterKey        String   @unique
  entityKey         String?
  status            String   @default("active")
  confidence        Float
  walletCount       Int      @default(0)
  firstDiscoveredAt DateTime
  lastEvidenceAt    DateTime
  evidenceJson      Json
  mergedIntoId      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mergedInto     IntelligenceCluster?             @relation("IntelligenceClusterMergeTarget", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedClusters IntelligenceCluster[]            @relation("IntelligenceClusterMergeTarget")
  profiles       WalletIntelligenceProfile[]
  observations   IntelligenceClusterObservation[]
  mergesFrom     IntelligenceClusterMerge[]       @relation("IntelligenceClusterMergeFrom")
  mergesInto     IntelligenceClusterMerge[]       @relation("IntelligenceClusterMergeInto")

  @@index([entityKey])
  @@index([status, lastEvidenceAt])
  @@map("intelligence_clusters")
}

/// Current materialized intelligence for one wallet. Every mutation is backed
/// by an immutable WalletIntelligenceObservation, so confidence may rise or
/// fall without losing the prior conclusion.
model WalletIntelligenceProfile {
  id                        String             @id @default(cuid())
  walletId                  String             @unique
  chain                     ChainId
  address                   String
  clusterId                 String
  entityKey                 String?
  role                      String
  evidenceScore             Float
  historicalAlphaScore      Float
  wakeUpPotential           Float
  confidence                Float
  tier                      String
  discoverySource           String
  lastDiscoverySource       String
  firstDiscoveredAt         DateTime
  lastObservedAt            DateTime
  lastActivityAt            DateTime?
  monitoringPriority        MonitoringPriority
  reasonAdded               String
  observationCount          Int                @default(0)
  independentSignals        Int                @default(0)
  evidenceSignals           String[]
  supportingEvidenceJson    Json
  contradictingEvidenceJson Json
  scoreVersion              Int
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  wallet       Wallet                          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  cluster      IntelligenceCluster             @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  observations WalletIntelligenceObservation[]
  events       WalletIntelligenceEvent[]

  @@unique([chain, address])
  @@index([clusterId, confidence])
  @@index([monitoringPriority, lastObservedAt])
  @@index([tier, historicalAlphaScore])
  @@map("wallet_intelligence_profiles")
}

/// Append-only conclusion history for a wallet.
model WalletIntelligenceObservation {
  id                        String   @id @default(cuid())
  observationKey            String   @unique
  profileId                 String
  investigationId           String?
  discoverySource           String
  entityKey                 String?
  role                      String
  evidenceScore             Float
  historicalAlphaScore      Float
  wakeUpPotential           Float
  confidence                Float
  previousConfidence        Float?
  confidenceDelta           Float
  tier                      String
  independentSignals        Int
  evidenceSignals           String[]
  supportingEvidenceJson    Json
  contradictingEvidenceJson Json
  reasonJson                Json
  evidenceHash              String
  scoreVersion              Int
  observedAt                DateTime
  createdAt                 DateTime @default(now())

  profile WalletIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, observedAt])
  @@index([investigationId])
  @@map("wallet_intelligence_observations")
}

/// Append-only cluster snapshot written by every qualifying investigation.
model IntelligenceClusterObservation {
  id                        String   @id @default(cuid())
  observationKey            String   @unique
  clusterId                 String
  investigationId           String?
  confidence                Float
  walletCount               Int
  supportingEvidenceJson    Json
  contradictingEvidenceJson Json
  observedAt                DateTime
  createdAt                 DateTime @default(now())

  cluster IntelligenceCluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  @@index([clusterId, observedAt])
  @@map("intelligence_cluster_observations")
}

/// Immutable audit receipt when two persistent clusters are reconciled.
model IntelligenceClusterMerge {
  id              String   @id @default(cuid())
  mergeKey        String   @unique
  fromClusterId   String
  intoClusterId   String
  investigationId String?
  confidence      Float
  reason          String
  evidenceJson    Json
  mergedAt        DateTime
  createdAt       DateTime @default(now())

  fromCluster IntelligenceCluster @relation("IntelligenceClusterMergeFrom", fields: [fromClusterId], references: [id], onDelete: Restrict)
  intoCluster IntelligenceCluster @relation("IntelligenceClusterMergeInto", fields: [intoClusterId], references: [id], onDelete: Restrict)

  @@index([fromClusterId])
  @@index([intoClusterId])
  @@map("intelligence_cluster_merges")
}

/// Canonical append-only activity stream for permanently monitored intelligence
/// wallets. One mass-tracker event may create one row per participating profile.
model WalletIntelligenceEvent {
  id                  String   @id @default(cuid())
  eventKey            String   @unique
  profileId           String
  clusterKey          String
  chain               ChainId
  walletAddress       String
  eventType           String
  sourceEventId       String?
  txHash              String?
  counterpartyAddress String?
  tokenAddress        String?
  amountUsd           Decimal? @db.Decimal(24, 4)
  occurredAt          DateTime
  evidenceJson        Json
  createdAt           DateTime @default(now())

  profile WalletIntelligenceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, occurredAt])
  @@index([clusterKey, eventType, occurredAt])
  @@index([chain, tokenAddress, occurredAt])
  @@map("wallet_intelligence_events")
}

/// Immutable token-quality receipt evaluated at cluster-signal time. Unknown
/// inputs stay unknown and lower coverage; they are never treated as safe.
model TokenQualityAssessment {
  id                 String   @id @default(cuid())
  assessmentKey      String   @unique
  chain              ChainId
  tokenAddress       String
  passed             Boolean
  score              Float
  coverage           String
  liquidityUsd       Decimal? @db.Decimal(24, 4)
  marketCapUsd       Decimal? @db.Decimal(24, 4)
  holderCount        Int?
  riskPenalty        Float?
  holderDistribution String
  deployerQuality    String
  ownershipStatus    String
  lpStatus           String
  tradingBehavior    String
  checksJson         Json
  reasonCodes        String[]
  assessedAt         DateTime
  createdAt          DateTime @default(now())

  signals       IntelligenceSignal[]
  buyCandidates IntelligenceBuyCandidate[]

  @@index([chain, tokenAddress, assessedAt])
  @@index([passed, score])
  @@map("token_quality_assessments")
}

/// Cluster-level signal. The engine structurally requires at least two
/// participating intelligence wallets/entities; a lone wallet buy cannot write
/// this row.
model IntelligenceSignal {
  id                  String                  @id @default(cuid())
  dedupeKey           String                  @unique
  chain               ChainId
  tokenAddress        String
  signalType          String
  level               IntelligenceSignalLevel
  score               Float
  status              String                  @default("active")
  activatedAt         DateTime
  clusterKeys         String[]
  entityKeys          String[]
  walletAddresses     String[]
  sourceEventIds      String[]
  reasons             String[]
  evidenceJson        Json
  historySupportJson  Json
  explanation         String
  qualityAssessmentId String?
  engineVersion       Int
  createdAt           DateTime                @default(now())

  qualityAssessment TokenQualityAssessment?   @relation(fields: [qualityAssessmentId], references: [id], onDelete: SetNull)
  buyCandidate      IntelligenceBuyCandidate?

  @@index([level, activatedAt])
  @@index([chain, tokenAddress, activatedAt])
  @@index([clusterKeys])
  @@map("intelligence_signals")
}

/// Research-only Buy Candidate. Creation requires BOTH a STRONG/HIGH cluster
/// signal and a passing TokenQualityAssessment. It never signs or trades.
model IntelligenceBuyCandidate {
  id                  String   @id @default(cuid())
  dedupeKey           String   @unique
  signalId            String   @unique
  qualityAssessmentId String
  chain               ChainId
  tokenAddress        String
  status              String   @default("active")
  confidence          Float
  reasonCodes         String[]
  evidenceJson        Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  signal            IntelligenceSignal     @relation(fields: [signalId], references: [id], onDelete: Restrict)
  qualityAssessment TokenQualityAssessment @relation(fields: [qualityAssessmentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([chain, tokenAddress])
  @@map("intelligence_buy_candidates")
}

/// Cursor/metrics receipt for the continuous intelligence lifecycle worker.
model IntelligenceLifecycleRun {
  id                   String    @id
  startedAt            DateTime
  completedAt          DateTime?
  sinceObservedAt      DateTime
  status               String
  profilesTracked      Int       @default(0)
  eventsProcessed      Int       @default(0)
  dormantAwakenings    Int       @default(0)
  signalsCreated       Int       @default(0)
  buyCandidatesCreated Int       @default(0)
  errorCount           Int       @default(0)
  metadataJson         Json

  @@index([startedAt])
  @@index([status])
  @@map("intelligence_lifecycle_runs")
}
