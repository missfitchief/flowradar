  enabled            Boolean   @default(true)
  chainSupport       ChainId[]
  apiKeyEnvName      String?
  rateLimitPerMinute Int       @default(30)
  status             String    @default("idle")
  lastSyncAt         DateTime?
  lastError          String?
  failCount          Int       @default(0)
  addedAt            DateTime  @default(now())
  metadataJson       Json?

  mentions           SocialMention[]

  @@map("social_sources")
}

// ---------------------------------------------------------------------------
// 27. SocialMention (Social Intelligence — spec §1; extractor output, shadow-only)
// ---------------------------------------------------------------------------

/// One extracted token mention from one social post. A post mentioning two
/// tokens produces two rows; zero-token posts are NOT stored (only counted).
/// `contentSnippet`/`normalizedSnippet` are SAFE, TRUNCATED (<=280 char)
/// excerpts — never a full raw-message archive. `tokenId` is nullable: when
/// the extracted token is not (yet) a Token row it stays null (graceful
/// skip / "unlinked" in the UI). `dedupeKey` is NON-NULL
/// (`${externalPostId}::${tokenAddress ?? '$'+tokenSymbol ?? 'none'}`), so
/// @@unique([sourceId, dedupeKey]) makes re-ingest idempotent without
/// NULLs-are-distinct surprises.
model SocialMention {
  id                String       @id @default(cuid())
  sourceId          String
  source            SocialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  platform          String
  externalPostId    String
  authorHash        String?
  postedAt          DateTime
  ingestedAt        DateTime     @default(now())
  chain             ChainId
  contentSnippet    String
  normalizedSnippet String
  contentHash       String
  mentionType       String
  tokenAddress      String?
  tokenSymbol       String?
  tokenUrl          String?
  tokenId           String?
  token             Token?       @relation(fields: [tokenId], references: [id])
  confidence        Int
  spamScore         Int          @default(0)
  spamReason        String?
  dedupeKey         String
  metadataJson      Json?

  @@unique([sourceId, dedupeKey])
  @@index([tokenId])
  @@index([chain, tokenAddress])
  @@index([postedAt])
  @@index([contentHash])
  @@map("social_mentions")
}

// ---------------------------------------------------------------------------
// 28. ExternalConfluenceSource (External Confluence — Task B; operator-managed registry)
// ---------------------------------------------------------------------------

/// One operator-registered external confluence/evidence provider (holderscan,
/// clobr, gmgn, ag_paper) or a keyless `manual` entry. Mirrors
/// ExternalWalletSource/SocialSource's registry role but is ENTIRELY SEPARATE:
/// confluence data is SHADOW-ONLY and never feeds FlowScore, signal rules,
/// wallet scoring, the candidate pipeline, or production alerts. `apiKeyEnvName`
/// stores the env VAR NAME of the provider credential (e.g. "HOLDERSCAN_API_KEY")
/// — NEVER a value; null for keyless (manual/internal) providers. The internal
/// LiquidityRisk snapshot has NO source row (TokenConfluenceSnapshot.sourceId is
/// null for it). `status` uses the source-level taxonomy
/// idle|live|mock|missing_key|plan_required|stub|unavailable|rate_limited|error.
model ExternalConfluenceSource {
  id                 String    @id @default(cuid())
  name               String    @unique
  provider           String    // holderscan | clobr | gmgn | ag_paper | manual
  enabled            Boolean   @default(true)
  apiKeyEnvName      String?   // env var NAME only; null for keyless (manual/internal)
  rateLimitPerMinute Int       @default(30)
  status             String    @default("idle") // idle|live|mock|missing_key|plan_required|stub|unavailable|rate_limited|error
  lastSyncAt         DateTime?
  lastError          String?
  failCount          Int       @default(0)
  metadataJson       Json?
  addedAt            DateTime  @default(now())

  snapshots          TokenConfluenceSnapshot[]

  @@map("external_confluence_sources")
}

// ---------------------------------------------------------------------------
// 29. TokenConfluenceSnapshot (External Confluence — Task B; shadow-only point-in-time evidence)
// ---------------------------------------------------------------------------

/// One point-in-time confluence/evidence observation for a token, from either an
/// external provider (sourceId set) or the INTERNAL LiquidityRisk computation
/// (sourceId null, provider "internal"). SHADOW-ONLY: there is NO column that
/// participates in FlowScore — all metrics live in `dataJson`, which is
/// DISPLAY-SAFE ONLY and MUST contain no secret values. `tokenId` is nullable
/// with onDelete: SetNull: external providers NEVER create Token rows, so a
/// not-yet-known token yields an "unlinked" snapshot keyed to (chain,
/// tokenAddress); deleting a Token nulls (never deletes) its snapshots. `status`
/// is honest per-fetch state — ok | unavailable | missing_key | plan_required |
/// rate_limited | error | stub — and is NEVER coerced to a reassuring value when
/// data is absent (unavailable != safe). `dedupeKey` is NON-NULL
/// (`${provider}:${snapshotType}:${tokenAddress}:${observedHourBucket}`), so
/// @@unique([sourceId, tokenAddress, snapshotType, dedupeKey]) makes re-ingest
/// idempotent. `snapshotType` includes `paper_trade` (AG Paper is manual/stub
/// only — there is deliberately NO separate PaperTradeObservation table).
model TokenConfluenceSnapshot {
  id           String    @id @default(cuid())
  tokenId      String?
  chain        ChainId
  tokenAddress String
  sourceId     String?
  provider     String    // holderscan | clobr | gmgn | ag_paper | manual | internal
  snapshotType String    // holder_risk | liquidity_risk | liquidity_map | external_intel | paper_trade
  status       String    // ok | unavailable | missing_key | plan_required | rate_limited | error | stub
  dataJson     Json      // computed/provider-claimed metrics — DISPLAY-SAFE, no secrets
  observedAt   DateTime
  ingestedAt   DateTime  @default(now())
  dedupeKey    String
  metadataJson Json?

  token        Token?                    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  source       ExternalConfluenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, tokenAddress, snapshotType, dedupeKey])
  @@index([tokenId])
  @@index([chain, tokenAddress])
  @@index([provider, snapshotType])
  @@index([observedAt])
  @@map("token_confluence_snapshots")
}

// ---------------------------------------------------------------------------
// Capital Lineage Engine — Phase 6a (feat/pre-public-accumulation, operator
// directive 2026-07-10). Roots are operator-supplied or validation-earned
// wallets whose money flow is tracked permanently; monitoring subscriptions
// are the scheduler's work queue (NO per-root timers — batches, cursors,
// provider rate budgets).
// ---------------------------------------------------------------------------

/// MonitoringSubscription.priority — scheduler tiers, highest first.
enum MonitoringPriority {
  fresh_receiver_hot
  root_permanent
  strong_link
  probable_link
  standard
  weak_cold
  cold_archive
}

model LineageRoot {
  id                  String   @id @default(cuid())
  walletId            String   @unique
  /// Where this root came from: 'operator_file' (manual import),
  /// 'validated_promotion' (Phase 6b+: wallets that pass local validation
  /// get their own root-expansion job), etc. Plain String, small vocab.
  source              String
  /// Optional operator label preserved from the import file's inline
  /// comment ("addr | label" / "addr # label").
  label               String?
  /// Import provenance (filename), for audit. Never a parsing input.
  fileProvenance      String?
  /// Roots are permanent by contract: absence from a LATER import file
  /// never deletes or deactivates a root (operator requirement 8).
  permanent           Boolean  @default(true)
  firstImportedAt     DateTime
  /// Bumped on every import that mentions this root again (idempotent
  /// re-import telemetry — NOT a liveness/expiry mechanism).
  lastSeenInImportAt  DateTime

  wallet              Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  subscriptions       MonitoringSubscription[]
  relationships       WalletRelationship[]
  expansionNodes      LineageExpansionNode[]

  @@index([source])
  @@map("lineage_roots")
}

model MonitoringSubscription {
  id            String             @id @default(cuid())
  walletId      String
  priority      MonitoringPriority
  active        Boolean            @default(true)
  /// Human-readable why: 'operator_root_import', 'first_funder of <addr>',
  /// 'weak_link_cooldown', ... Probabilistic wording only — never identity
  /// claims.
  reason        String
  /// The lineage root this subscription hangs off (a receiver's
  /// subscription points at its funder's root). Null for standalone tiers.
  lineageRootId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // --- Scheduler fields (Wave C) — queue-based, NO per-wallet timers ---
  /// When this subscription is next due to be polled. NULL = due immediately.
  nextPollAt        DateTime?
  lastPolledAt      DateTime?
  pollCount         Int      @default(0)
  /// Consecutive poll errors — drives exponential backoff.
  consecutiveErrors Int      @default(0)
  /// fresh_receiver_hot expiry: after this the tier demotes to probable_link.
  hotUntil          DateTime?
  /// Set when a scheduler batch claims this row; cleared on completion. A
  /// stale claim (older than the reclaim window) is reclaimable.
  claimedAt         DateTime?
  /// Explicit tier rank (0=highest) for DB-side priority ordering. The
  /// MonitoringPriority ENUM's on-disk order reflects migration order, NOT
  /// tier priority, so ordering by the enum is wrong — this integer is the
  /// source of truth. Maintained by every writer via @flowradar/core tierRank.
  tierPriority      Int      @default(99)

  wallet        Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  lineageRoot   LineageRoot?       @relation(fields: [lineageRootId], references: [id], onDelete: SetNull)

  /// Scheduler read path: due, active subscriptions by explicit tier rank.
  @@index([active, tierPriority, nextPollAt])
  /// One subscription per wallet per tier — re-imports upsert, never stack.
  @@unique([walletId, priority])
  /// The scheduler's read path: active subscriptions by tier, batched.
  @@index([priority, active])
  @@map("monitoring_subscriptions")
}

/// WalletRelationship.kind — probabilistic on-chain relationship vocabulary
/// (possible/probable/strong wording lives in `confidence`, never identity
/// claims).
enum WalletRelationshipKind {
  first_funder
  direct_funding
  repeated_transfer
  fresh_wallet_activation
  service_interrupted
  unknown
}

model WalletRelationship {
  id                  String                 @id @default(cuid())
  lineageRootId       String
  /// Sender side of the observed flow.
  walletAId           String
  /// Receiver side of the observed flow.
  walletBId           String
  kind                WalletRelationshipKind
  /// 0-100. Bands map to possible (<50) / probable (50-79) / strong (>=80)
  /// via @flowradar/core confidenceBand — same vocabulary as /flow.
  confidence          Float
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  interactionCount    Int                    @default(1)
  /// Sum of KNOWN transfer value across interactions. Unavailable/unknown-value
  /// legs contribute nothing here (never fabricated as $0); their count lives in
  /// unknownValueTxCount so this figure's incompleteness is explicit.
  valueTransferredUsd Decimal                @db.Decimal(20, 4)
  /// How many counted interactions had UNAVAILABLE (unpriced) value — so
  /// valueTransferredUsd is honestly "sum of known value", not a claimed total.
  /// Revaluation lowers this as edges get priced.
  unknownValueTxCount Int                    @default(0)
  /// Evidence trail: tx signatures, edge ids, classification inputs.
  evidence            Json

  lineageRoot         LineageRoot            @relation(fields: [lineageRootId], references: [id], onDelete: Cascade)
  walletA             Wallet                 @relation("RelationshipSender", fields: [walletAId], references: [id], onDelete: Cascade)
  walletB             Wallet                 @relation("RelationshipReceiver", fields: [walletBId], references: [id], onDelete: Cascade)

  /// One relationship row per (root, pair, kind) — repeat observations bump
  /// interactionCount/lastSeenAt/value instead of stacking rows.
  @@unique([lineageRootId, walletAId, walletBId, kind])
  @@index([walletBId])
  @@index([lineageRootId, kind])
  @@map("wallet_relationships")
}

/// ObservationProviderSnapshot — SHADOW-ONLY store for provider-CLAIMED wallet
/// stats gathered by the observation-universe importer (Wave D). Deliberately
/// SEPARATE from WalletStats: WalletStats is read by the FlowScore path
/// (fetchAggregateInputs -> computeFlowScore averages walletScore across ALL
/// buyers), so writing an uncomputed provider row there would corrupt FlowScore
/// (hard-rule-1). Nothing reads this model for scoring/eligibility — it is pure
/// provider-claimed context on observation_only wallets. Fields the provider
/// did NOT supply are NULLABLE (honest unknown, never a fabricated 0). Upserted
/// on (walletId, source, window) so re-import is idempotent and concurrent
/// writes cannot duplicate.
model ObservationProviderSnapshot {
  id              String   @id @default(cuid())
  walletId        String
  /// Provider/source label the claim came from (e.g. 'solana_tracker'). NOT locally verified.
  source          String
  /// Rolling window label, e.g. '30d'.
  window          String
  /// Provider-claimed 30d PnL TOTAL. Null when not supplied — never 0-as-unknown.
  pnlUsd          Decimal? @db.Decimal(20, 4)
  winRate         Float?
  tradeCount      Int?
  avgTradeSizeUsd Decimal? @db.Decimal(20, 4)
  /// Always true — these numbers are provider-CLAIMED, never locally verified.
  providerClaimed Boolean  @default(true)
  observedAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, source, window])
  @@index([walletId])
  @@map("observation_provider_snapshot")
}

/// GmgnObservation — append-only RAW query-only GMGN feed rows (Task 2). Every
/// row is provider-CLAIMED evidence, never locally verified: it feeds the
/// candidate buffer + behavior reconstruction, and NOTHING here grants smart
/// votes or eligibility (the WalletStatus gate is enforced separately). One
/// row per distinct (sourceCommand, wallet, token, activityTs, side) — the
/// dedupe key makes re-polling idempotent.
model GmgnObservation {
  id                  String   @id @default(cuid())
  chain               ChainId
  /// The read-only gmgn-cli command family this came from
  /// (e.g. 'track smartmoney', 'token traders', 'portfolio activity').
  sourceCommand       String
  walletAddress       String
  tokenAddress        String?
  /// Transaction signature for this activity (receipts, Task 14). Part of the
  /// dedupe identity so same-second distinct trades never collapse.
  txHash              String?
  /// GMGN activity/event type verbatim ('buy'|'sell'|'transferIn'|'transferOut'|null).
  activityType        String?
  /// Normalized side when derivable ('buy'|'sell'|'transfer'|null-unknown).
  side                String?
  amountToken         Decimal? @db.Decimal(38, 18)
  amountUsd           Decimal? @db.Decimal(20, 4)
  /// Provider-claimed metrics (NEVER treated as locally verified).
  providerPnlUsd      Decimal? @db.Decimal(20, 4)
  providerWinRate     Float?
  providerTradeCount  Int?
  /// Raw provider label(s) verbatim (wallet_tag_v2 / maker_info / tags…).
  rawClassification   Json?
  /// Provider KOL/promoter indicators present on this row.
  isKolTagged         Boolean  @default(false)
  isPromoterTagged    Boolean  @default(false)
  /// When the activity happened (provider unix ts) vs when we fetched it.
  activityTs          DateTime?
  retrievedAt         DateTime
  /// Pagination cursor/provenance this row was retrieved under.
  cursor              String?
  /// 'complete' | 'partial' | 'unknown' — never silently 'ok'.
  dataQuality         String   @default("complete")
  /// Stable hash of the dedupe tuple (sourceCommand|wallet|token|activityTs|side).
  dedupeKey           String
  createdAt           DateTime @default(now())

  @@unique([dedupeKey])
  @@index([walletAddress])
  @@index([tokenAddress])
  @@index([sourceCommand, retrievedAt])
  @@map("gmgn_observations")
}

/// LineageExpansionNode.priority — expansion queue order (spec order).
enum ExpansionPriority {
  first_funder
  direct_high_value
  fresh_activation
  post_funding_buy
  bridge_correlated
  repeated_transfer
  profit_rotation
  weak
}

/// LineageExpansionNode.status — queue lifecycle.
enum ExpansionNodeStatus {
  pending
  in_progress
  done
  skipped
}

/// The PERSISTENT priority frontier for bounded recursive expansion — a
/// queue table consumed in priority batches under provider budgets (never
/// one timer per wallet). `cursor` checkpoints provider pagination so an
/// interrupted backfill resumes instead of restarting.
model LineageExpansionNode {
  id            String              @id @default(cuid())
  lineageRootId String
  walletAddress String
  chain         ChainId
  depth         Int
  priority      ExpansionPriority
  status        ExpansionNodeStatus @default(pending)
  /// Persisted when expansion stops: 'max_depth', 'service_node',
  /// 'node_cap', 'edge_cap', 'receiver_day_cap', 'below_min_usd', ...
  stopReason    String?
  /// How this node entered the frontier (audit): 'root', 'first_funder of
  /// <addr>', 'bridge_correlated', ...
  discoveredVia String
  /// Provider pagination checkpoint (resume-safe interrupted backfill).
  cursor        String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lineageRoot   LineageRoot         @relation(fields: [lineageRootId], references: [id], onDelete: Cascade)

  @@unique([lineageRootId, walletAddress])
  @@index([status, priority])
  @@map("lineage_expansion_nodes")
}
