// ---------------------------------------------------------------------------
// 26. SocialSource (Social Intelligence — spec §1; operator-managed registry)
// ---------------------------------------------------------------------------

/// One operator-registered inbound social reader (Telegram/Discord channel,
/// or a `manual` registry-only entry with no automated reader this phase).
/// Mirrors ExternalWalletSource's role for the wallet-candidate pipeline, but
/// is ENTIRELY SEPARATE from it: social data is shadow-only confluence
/// evidence and never feeds FlowScore, signal rules, wallet scoring, or
/// production alerts. `apiKeyEnvName` stores the env VAR NAME of the read
/// credential (never a value), distinct from the outbound alert sender's
/// TELEGRAM_BOT_TOKEN. `trustTier` is operator-assigned display/weighting
/// confidence only — it never feeds scoring.
model SocialSource {
  id                 String    @id @default(cuid())
  name               String    @unique
  platform           String
  externalId         String?
  inviteLink         String?
  notes              String?
  trustTier          String    @default("medium")
  enabled            Boolean   @default(true)
  chainSupport       ChainId[]
  apiKeyEnvName      String?
  rateLimitPerMinute Int       @default(30)
  status             String    @default("idle")
  lastSyncAt         DateTime?
  lastError          String?
  failCount          Int       @default(0)
  addedAt            DateTime  @default(now())
  metadataJson       Json?

  mentions SocialMention[]

  @@map("social_sources")
}

// ---------------------------------------------------------------------------
// 27. SocialMention (Social Intelligence — spec §1; extractor output, shadow-only)
// ---------------------------------------------------------------------------

/// One extracted token mention from one social post. A post mentioning two
/// tokens produces two rows; zero-token posts are NOT stored (only counted).
/// `contentSnippet`/`normalizedSnippet` are SAFE, TRUNCATED (<=280 char)
/// excerpts — never a full raw-message archive. `tokenId` is nullable: when
/// the extracted token is not (yet) a Token row it stays null (graceful
/// skip / "unlinked" in the UI). `dedupeKey` is NON-NULL
/// (`${externalPostId}::${tokenAddress ?? '$'+tokenSymbol ?? 'none'}`), so
/// @@unique([sourceId, dedupeKey]) makes re-ingest idempotent without
/// NULLs-are-distinct surprises.
model SocialMention {
  id                String       @id @default(cuid())
  sourceId          String
  source            SocialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  platform          String
  externalPostId    String
  authorHash        String?
  postedAt          DateTime
  ingestedAt        DateTime     @default(now())
  chain             ChainId
  contentSnippet    String
  normalizedSnippet String
  contentHash       String
  mentionType       String
  tokenAddress      String?
  tokenSymbol       String?
  tokenUrl          String?
  tokenId           String?
  token             Token?       @relation(fields: [tokenId], references: [id])
  confidence        Int
  spamScore         Int          @default(0)
  spamReason        String?
  dedupeKey         String
  metadataJson      Json?

  @@unique([sourceId, dedupeKey])
  @@index([tokenId])
  @@index([chain, tokenAddress])
  @@index([postedAt])
  @@index([contentHash])
  @@map("social_mentions")
}

// ---------------------------------------------------------------------------
// 28. ExternalConfluenceSource (External Confluence — Task B; operator-managed registry)
// ---------------------------------------------------------------------------

/// One operator-registered external confluence/evidence provider (holderscan,
/// clobr, gmgn, ag_paper) or a keyless `manual` entry. Mirrors
/// ExternalWalletSource/SocialSource's registry role but is ENTIRELY SEPARATE:
/// confluence data is SHADOW-ONLY and never feeds FlowScore, signal rules,
/// wallet scoring, the candidate pipeline, or production alerts. `apiKeyEnvName`
/// stores the env VAR NAME of the provider credential (e.g. "HOLDERSCAN_API_KEY")
/// — NEVER a value; null for keyless (manual/internal) providers. The internal
/// LiquidityRisk snapshot has NO source row (TokenConfluenceSnapshot.sourceId is
/// null for it). `status` uses the source-level taxonomy
/// idle|live|mock|missing_key|plan_required|stub|unavailable|rate_limited|error.
model ExternalConfluenceSource {
  id                 String    @id @default(cuid())
  name               String    @unique
  provider           String // holderscan | clobr | gmgn | ag_paper | manual
  enabled            Boolean   @default(true)
  apiKeyEnvName      String? // env var NAME only; null for keyless (manual/internal)
  rateLimitPerMinute Int       @default(30)
  status             String    @default("idle") // idle|live|mock|missing_key|plan_required|stub|unavailable|rate_limited|error
  lastSyncAt         DateTime?
  lastError          String?
  failCount          Int       @default(0)
  metadataJson       Json?
  addedAt            DateTime  @default(now())

  snapshots TokenConfluenceSnapshot[]

  @@map("external_confluence_sources")
}

// ---------------------------------------------------------------------------
// 29. TokenConfluenceSnapshot (External Confluence — Task B; shadow-only point-in-time evidence)
// ---------------------------------------------------------------------------

/// One point-in-time confluence/evidence observation for a token, from either an
/// external provider (sourceId set) or the INTERNAL LiquidityRisk computation
/// (sourceId null, provider "internal"). SHADOW-ONLY: there is NO column that
/// participates in FlowScore — all metrics live in `dataJson`, which is
/// DISPLAY-SAFE ONLY and MUST contain no secret values. `tokenId` is nullable
/// with onDelete: SetNull: external providers NEVER create Token rows, so a
/// not-yet-known token yields an "unlinked" snapshot keyed to (chain,
/// tokenAddress); deleting a Token nulls (never deletes) its snapshots. `status`
/// is honest per-fetch state — ok | unavailable | missing_key | plan_required |
/// rate_limited | error | stub — and is NEVER coerced to a reassuring value when
/// data is absent (unavailable != safe). `dedupeKey` is NON-NULL
/// (`${provider}:${snapshotType}:${tokenAddress}:${observedHourBucket}`), so
/// @@unique([sourceId, tokenAddress, snapshotType, dedupeKey]) makes re-ingest
/// idempotent. `snapshotType` includes `paper_trade` (AG Paper is manual/stub
/// only — there is deliberately NO separate PaperTradeObservation table).
model TokenConfluenceSnapshot {
  id           String   @id @default(cuid())
  tokenId      String?
  chain        ChainId
  tokenAddress String
  sourceId     String?
  provider     String // holderscan | clobr | gmgn | ag_paper | manual | internal
  snapshotType String // holder_risk | liquidity_risk | liquidity_map | external_intel | paper_trade
  status       String // ok | unavailable | missing_key | plan_required | rate_limited | error | stub
  dataJson     Json // computed/provider-claimed metrics — DISPLAY-SAFE, no secrets
  observedAt   DateTime
  ingestedAt   DateTime @default(now())
  dedupeKey    String
  metadataJson Json?

  token  Token?                    @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  source ExternalConfluenceSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, tokenAddress, snapshotType, dedupeKey])
  @@index([tokenId])
  @@index([chain, tokenAddress])
  @@index([provider, snapshotType])
  @@index([observedAt])
  @@map("token_confluence_snapshots")
}

// ---------------------------------------------------------------------------
// Capital Lineage Engine — Phase 6a (feat/pre-public-accumulation, operator
// directive 2026-07-10). Roots are operator-supplied or validation-earned
// wallets whose money flow is tracked permanently; monitoring subscriptions
// are the scheduler's work queue (NO per-root timers — batches, cursors,
// provider rate budgets).
// ---------------------------------------------------------------------------

/// MonitoringSubscription.priority — scheduler tiers, highest first.
enum MonitoringPriority {
  fresh_receiver_hot
  root_permanent
  strong_link
  probable_link
  standard
  weak_cold
  cold_archive
}

model LineageRoot {
  id                 String   @id @default(cuid())
  walletId           String   @unique
  /// Where this root came from: 'operator_file' (manual import),
  /// 'validated_promotion' (Phase 6b+: wallets that pass local validation
  /// get their own root-expansion job), etc. Plain String, small vocab.
  source             String
  /// Optional operator label preserved from the import file's inline
  /// comment ("addr | label" / "addr # label").
  label              String?
  /// Import provenance (filename), for audit. Never a parsing input.
  fileProvenance     String?
  /// Roots are permanent by contract: absence from a LATER import file
  /// never deletes or deactivates a root (operator requirement 8).
  permanent          Boolean  @default(true)
  firstImportedAt    DateTime
  /// Bumped on every import that mentions this root again (idempotent
  /// re-import telemetry — NOT a liveness/expiry mechanism).
  lastSeenInImportAt DateTime

  wallet         Wallet                   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  subscriptions  MonitoringSubscription[]
  relationships  WalletRelationship[]
  expansionNodes LineageExpansionNode[]

  @@index([source])
  @@map("lineage_roots")
}

model MonitoringSubscription {
  id            String             @id @default(cuid())
  walletId      String
  priority      MonitoringPriority
  active        Boolean            @default(true)
  /// Human-readable why: 'operator_root_import', 'first_funder of <addr>',
  /// 'weak_link_cooldown', ... Probabilistic wording only — never identity
  /// claims.
  reason        String
  /// The lineage root this subscription hangs off (a receiver's
  /// subscription points at its funder's root). Null for standalone tiers.
  lineageRootId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // --- Scheduler fields (Wave C) — queue-based, NO per-wallet timers ---
  /// When this subscription is next due to be polled. NULL = due immediately.
  nextPollAt        DateTime?
  lastPolledAt      DateTime?
  pollCount         Int       @default(0)
  /// Consecutive poll errors — drives exponential backoff.
  consecutiveErrors Int       @default(0)
  /// fresh_receiver_hot expiry: after this the tier demotes to probable_link.
  hotUntil          DateTime?
  /// Set when a scheduler batch claims this row; cleared on completion. A
  /// stale claim (older than the reclaim window) is reclaimable.
  claimedAt         DateTime?
  /// Explicit tier rank (0=highest) for DB-side priority ordering. The
  /// MonitoringPriority ENUM's on-disk order reflects migration order, NOT
  /// tier priority, so ordering by the enum is wrong — this integer is the
  /// source of truth. Maintained by every writer via @flowradar/core tierRank.
  tierPriority      Int       @default(99)

  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  lineageRoot LineageRoot? @relation(fields: [lineageRootId], references: [id], onDelete: SetNull)

  /// One subscription per wallet per tier — re-imports upsert, never stack.
  @@unique([walletId, priority])
  /// Scheduler read path: due, active subscriptions by explicit tier rank.
  @@index([active, tierPriority, nextPollAt])
  /// The scheduler's read path: active subscriptions by tier, batched.
  @@index([priority, active])
  @@map("monitoring_subscriptions")
}

/// WalletRelationship.kind — probabilistic on-chain relationship vocabulary
/// (possible/probable/strong wording lives in `confidence`, never identity
/// claims).
enum WalletRelationshipKind {
  first_funder
  direct_funding
  repeated_transfer
  fresh_wallet_activation
  service_interrupted
  unknown
}

model WalletRelationship {
  id                  String                 @id @default(cuid())
  lineageRootId       String
  /// Sender side of the observed flow.
  walletAId           String
  /// Receiver side of the observed flow.
  walletBId           String
  kind                WalletRelationshipKind
  /// 0-100. Bands map to possible (<50) / probable (50-79) / strong (>=80)
  /// via @flowradar/core confidenceBand — same vocabulary as /flow.
  confidence          Float
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  interactionCount    Int                    @default(1)
  /// Sum of KNOWN transfer value across interactions. Unavailable/unknown-value
  /// legs contribute nothing here (never fabricated as $0); their count lives in
  /// unknownValueTxCount so this figure's incompleteness is explicit.
  valueTransferredUsd Decimal                @db.Decimal(20, 4)
  /// How many counted interactions had UNAVAILABLE (unpriced) value — so
  /// valueTransferredUsd is honestly "sum of known value", not a claimed total.
  /// Revaluation lowers this as edges get priced.
  unknownValueTxCount Int                    @default(0)
  /// Evidence trail: tx signatures, edge ids, classification inputs.
  evidence            Json

  lineageRoot LineageRoot @relation(fields: [lineageRootId], references: [id], onDelete: Cascade)
  walletA     Wallet      @relation("RelationshipSender", fields: [walletAId], references: [id], onDelete: Cascade)
  walletB     Wallet      @relation("RelationshipReceiver", fields: [walletBId], references: [id], onDelete: Cascade)

  /// One relationship row per (root, pair, kind) — repeat observations bump
  /// interactionCount/lastSeenAt/value instead of stacking rows.
  @@unique([lineageRootId, walletAId, walletBId, kind])
  @@index([walletBId])
  @@index([lineageRootId, kind])
  @@map("wallet_relationships")
}

/// ObservationProviderSnapshot — SHADOW-ONLY store for provider-CLAIMED wallet
/// stats gathered by the observation-universe importer (Wave D). Deliberately
/// SEPARATE from WalletStats: WalletStats is read by the FlowScore path
/// (fetchAggregateInputs -> computeFlowScore averages walletScore across ALL
/// buyers), so writing an uncomputed provider row there would corrupt FlowScore
/// (hard-rule-1). Nothing reads this model for scoring/eligibility — it is pure
/// provider-claimed context on observation_only wallets. Fields the provider
/// did NOT supply are NULLABLE (honest unknown, never a fabricated 0). Upserted
/// on (walletId, source, window) so re-import is idempotent and concurrent
/// writes cannot duplicate.
model ObservationProviderSnapshot {
  id              String   @id @default(cuid())
  walletId        String
  /// Provider/source label the claim came from (e.g. 'solana_tracker'). NOT locally verified.
  source          String
  /// Rolling window label, e.g. '30d'.
  window          String
  /// Provider-claimed 30d PnL TOTAL. Null when not supplied — never 0-as-unknown.
  pnlUsd          Decimal? @db.Decimal(20, 4)
  winRate         Float?
  tradeCount      Int?
  avgTradeSizeUsd Decimal? @db.Decimal(20, 4)
  /// Always true — these numbers are provider-CLAIMED, never locally verified.
  providerClaimed Boolean  @default(true)
  observedAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, source, window])
  @@index([walletId])
  @@map("observation_provider_snapshot")
}

/// GmgnObservation — append-only RAW query-only GMGN feed rows (Task 2). Every
/// row is provider-CLAIMED evidence, never locally verified: it feeds the
/// candidate buffer + behavior reconstruction, and NOTHING here grants smart
/// votes or eligibility (the WalletStatus gate is enforced separately). One
/// row per distinct (sourceCommand, wallet, token, activityTs, side) — the
/// dedupe key makes re-polling idempotent.
model GmgnObservation {
  id                 String    @id @default(cuid())
  chain              ChainId
  /// The read-only gmgn-cli command family this came from
  /// (e.g. 'track smartmoney', 'token traders', 'portfolio activity').
  sourceCommand      String
  walletAddress      String
  tokenAddress       String?
  /// Transaction signature for this activity (receipts, Task 14). Part of the
  /// dedupe identity so same-second distinct trades never collapse.
  txHash             String?
  /// GMGN activity/event type verbatim ('buy'|'sell'|'transferIn'|'transferOut'|null).
  activityType       String?
  /// Normalized side when derivable ('buy'|'sell'|'transfer'|null-unknown).
  side               String?
  amountToken        Decimal?  @db.Decimal(38, 18)
  amountUsd          Decimal?  @db.Decimal(20, 4)
  /// Provider-claimed metrics (NEVER treated as locally verified).
  providerPnlUsd     Decimal?  @db.Decimal(20, 4)
  providerWinRate    Float?
  providerTradeCount Int?
  /// Raw provider label(s) verbatim (wallet_tag_v2 / maker_info / tags…).
  rawClassification  Json?
  /// Provider KOL/promoter indicators present on this row.
  isKolTagged        Boolean   @default(false)
  isPromoterTagged   Boolean   @default(false)
  /// When the activity happened (provider unix ts) vs when we fetched it.
  activityTs         DateTime?
  retrievedAt        DateTime
  /// Pagination cursor/provenance this row was retrieved under.
  cursor             String?
  /// 'complete' | 'partial' | 'unknown' — never silently 'ok'.
  dataQuality        String    @default("complete")
  /// Stable hash of the dedupe tuple (sourceCommand|wallet|token|activityTs|side).
  dedupeKey          String
  createdAt          DateTime  @default(now())

  @@unique([dedupeKey])
  @@index([walletAddress])
  @@index([tokenAddress])
  @@index([sourceCommand, retrievedAt])
  @@map("gmgn_observations")
}

/// LineageExpansionNode.priority — expansion queue order (spec order).
enum ExpansionPriority {
  first_funder
  direct_high_value
  fresh_activation
  post_funding_buy
  bridge_correlated
  repeated_transfer
  profit_rotation
  weak
}

/// LineageExpansionNode.status — queue lifecycle.
enum ExpansionNodeStatus {
  pending
  in_progress
  done
  skipped
}

/// The PERSISTENT priority frontier for bounded recursive expansion — a
/// queue table consumed in priority batches under provider budgets (never
/// one timer per wallet). `cursor` checkpoints provider pagination so an
/// interrupted backfill resumes instead of restarting.
model LineageExpansionNode {
  id            String              @id @default(cuid())
  lineageRootId String
  walletAddress String
  chain         ChainId
  depth         Int
  priority      ExpansionPriority
  status        ExpansionNodeStatus @default(pending)
  /// Persisted when expansion stops: 'max_depth', 'service_node',
  /// 'node_cap', 'edge_cap', 'receiver_day_cap', 'below_min_usd', ...
  stopReason    String?
  /// How this node entered the frontier (audit): 'root', 'first_funder of
  /// <addr>', 'bridge_correlated', ...
  discoveredVia String
  /// Provider pagination checkpoint (resume-safe interrupted backfill).
  cursor        String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  lineageRoot LineageRoot @relation(fields: [lineageRootId], references: [id], onDelete: Cascade)

  @@unique([lineageRootId, walletAddress])
  @@index([status, priority])
  @@map("lineage_expansion_nodes")
}

/// Reconstructed wallet behavior (GMGN behavior plan Task 4 / directive Task 3).
/// One row per (chain, wallet): the FULL field-level-provenance BehaviorProfile
/// (profileJson) + the Task-4 hold/dump classification (classifierJson).
/// SHADOW-ONLY analytics: never read by FlowScore, signals, wallet scoring,
/// or eligibility — the classifier result itself carries grantsEligibility:false.
model WalletBehaviorProfile {
  id             String   @id @default(cuid())
  chain          ChainId
  walletAddress  String
  engineVersion  Int
  /// 'local_and_provider' | 'local_only' | 'provider_only' | 'insufficient'
  dataQuality    String
  computedAt     DateTime
  /// @flowradar/core BehaviorProfile, verbatim (per-field provenance inside).
  profileJson    Json
  /// @flowradar/core HoldClassifierResult, verbatim (labels + metrics + caveats).
  classifierJson Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([chain, walletAddress])
  @@index([dataQuality])
  @@map("wallet_behavior_profiles")
}

/// Runner Mining Task 1-2 — canonical historical token universe + runner
/// classification (one row per canonical Solana mint). SHADOW-ONLY analytics.
model TokenLifecycle {
  id                String    @id @default(cuid())
  /// Canonical Solana mint — THE dedupe key (one lifecycle per mint, ever).
  mint              String    @unique
  tokenId           String?
  enteredUniverseAt DateTime
  /// Provenance: which local sources evidence this token (tables, counts, spans).
  sourcesJson       Json
  /// covered | partially_covered | unavailable | invalid | unsupported | quarantined
  coverage          String
  seriesPointCount  Int       @default(0)
  firstObservedAt   DateTime?
  lastObservedAt    DateTime?
  /// Task 2 (null until classified): verified_above_10m | verified_below_10m |
  /// insufficient_history | conflicting_evidence | invalid
  runnerClass       String?
  athMcapUsd        Decimal?  @db.Decimal(20, 4)
  athTs             DateTime?
  baselineMcapUsd   Decimal?  @db.Decimal(20, 4)
  outcomeLabels     Json?
  /// high | medium | low — from series anchoring + point density.
  confidence        String?
  evidenceJson      Json?
  classifiedAt      DateTime?
  engineVersion     Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([coverage])
  @@index([runnerClass])
  @@map("token_lifecycles")
}

/// Runner Mining Task 3 — matched control per verified runner (or an explicit
/// no-valid-control record). Matching uses PRE-OUTCOME features only.
model CohortMatch {
  id           String   @id @default(cuid())
  runnerMint   String   @unique
  controlMint  String?
  /// matched_tier1 | matched_tier2 | no_valid_control
  status       String
  tier         String?
  distance     Float?
  featuresJson Json
  /// Candidate mints considered-but-rejected with reasons (bounded sample).
  excludedJson Json?
  confidence   String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@map("cohort_matches")
}

/// Runner Mining Task 4 — early-buyer entries below configured mcap bands
/// for runner + control tokens. Receipts-level rows (tx-anchored).
model EarlyBuyerEntry {
  id            String   @id @default(cuid())
  mint          String
  cohort        String
  walletAddress String
  txHash        String
  blockOrSlot   BigInt
  ts            DateTime
  entryMcapUsd  Decimal? @db.Decimal(20, 4)
  /// under_5k | 5k_to_10k | 10k_to_20k | 20k_to_50k (research bands)
  band          String
  /// Chronological buyer rank within the mint (1 = first observed buyer).
  buyerRank     Int
  /// Confidence honestly lowered when pre-trade coverage is incomplete.
  confidence    String
  sourceJson    Json
  createdAt     DateTime @default(now())

  @@unique([mint, txHash, walletAddress])
  @@index([mint])
  @@index([band])
  @@map("early_buyer_entries")
}

/// Runner Mining — Birdeye historical enrichment (one row per mint). Evidence
/// layer only: candles + labeled supply assumption -> reconstructed ATH mcap.
/// SHADOW-ONLY; never read by FlowScore/signals/eligibility.
model TokenEnrichment {
  id            String    @id @default(cuid())
  mint          String    @unique
  provider      String    @default("birdeye")
  /// Earliest provable market timestamp (first returned candle).
  ohlcvStartTs  DateTime?
  ohlcvEndTs    DateTime?
  candleCount   Int       @default(0)
  /// Bounded 1D candles [{t,o,h,l,c}] (candle-END semantics for no-lookahead).
  candlesJson   Json?
  /// { supply, source: 'current_supply_assumption' | 'unavailable' } — labeled, never claimed historical.
  supplyJson    Json?
  athMcapUsd    Decimal?  @db.Decimal(24, 4)
  athTs         DateTime?
  /// enriched | no_ohlcv | no_supply | provider_error
  status        String
  confidence    String
  receiptsJson  Json
  retryCount    Int       @default(0)
  lastError     String?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@map("token_enrichments")
}

/// Dormancy Task 6 — per-event meaningful-activity classification (the
/// gatekeeper for every dormancy calculation: only `meaningful` rows may
/// establish or reset dormancy). One row per (source row, wallet perspective)
/// — source tables are unique-constrained on their own natural keys, so the
/// (sourceTable, sourceId, walletAddress, chain) key is idempotent by
/// construction (chain included: a cross-chain edge can carry the same
/// textual address on both sides).
/// SHADOW-ONLY analytics: never read by FlowScore/signals/eligibility.
model WalletActivityClassification {
  id                  String   @id @default(cuid())
  chain               ChainId
  walletAddress       String
  /// 'wallet_token_trades' | 'money_flow_edges' — provenance of the source row.
  sourceTable         String
  /// Source row id (stable across reruns).
  sourceId            String
  /// 'trade' | 'transfer'
  eventKind           String
  /// BUY | SELL (trades); in | out (transfers, wallet perspective).
  eventRole           String
  txHash              String
  tokenAddress        String?
  counterpartyAddress String?
  eventTs             DateTime
  /// HONEST valuation — NULL == unknown (never 0-for-unknown).
  usd                 Decimal? @db.Decimal(20, 4)
  classification      String
  meaningful          Boolean
  reasonCodes         String[]
  confidence          Float
  ruleVersion         Int
  receiptsJson        Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// map matches the hand-authored 20260712001000 migration's index name
  /// (chain widened into the key) — keeps schema and DB drift-free.
  @@unique([sourceTable, sourceId, walletAddress, chain], map: "wallet_activity_classifications_sourceTable_sourceId_wa_key")
  @@index([chain, walletAddress, meaningful, eventTs])
  @@index([classification])
  @@map("wallet_activity_classifications")
}

/// Dormancy Task 7 — strictly-pre-event address dormancy observation, one row
/// per (wallet, anchor). Windows over MEANINGFUL events only; coverage-start
/// honesty (history starting inside a window is incomplete, never dormant).
/// SHADOW-ONLY analytics: never read by FlowScore/signals/eligibility.
model AddressDormancyObservation {
  id                    String    @id @default(cuid())
  chain                 ChainId
  walletAddress         String
  /// Anchor vocabulary: 'token_entry' (first local buy of a token).
  eventKind             String
  /// Non-null anchor discriminator (token address for token_entry).
  anchorKey             String
  eventTs               DateTime
  /// fresh | covered_dormant | active | apparently_dormant_incomplete_history | unknown
  overallClass          String
  maxCoveredDormantDays Int?
  coverageStartTs       DateTime?
  /// Strictly-pre-event meaningful events considered.
  meaningfulEventCount  Int
  windowsJson           Json
  receiptsJson          Json
  caveats               String[]
  engineVersion         Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([chain, walletAddress, eventKind, anchorKey])
  @@index([overallClass])
  @@index([chain, walletAddress])
  @@map("address_dormancy_observations")
}

/// Dormancy Task 8 — entity-level dormancy observation joining the address
/// observation with probabilistic wallet links (wallet_relationships +
/// money_flow_edges + receipts-engine tiers). Per-link receipts; service
/// nodes excluded; NEUTRAL wording (possible/probable linked wallet — never
/// same-person claims). SHADOW-ONLY analytics.
model EntityDormancyObservation {
  id                      String   @id @default(cuid())
  chain                   ChainId
  walletAddress           String
  eventKind               String
  anchorKey               String
  eventTs                 DateTime
  /// independent_dormant_entity | address_dormant_entity_active |
  /// probable_side_wallet_reactivation | fresh_funded_by_active_entity |
  /// active_entity | insufficient_evidence
  entityClass             String
  /// The Task 7 address-level class this row was derived from.
  addressClass            String
  linkedWalletsConsidered Int
  linkedWalletsActive     Int
  serviceNodesExcluded    Int
  confidence              Float
  reasonCodes             String[]
  /// Per-link receipts: counterparty, tier, kinds, evidence tx/edge ids.
  linksJson               Json
  receiptsJson            Json
  caveats                 String[]
  engineVersion           Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([chain, walletAddress, eventKind, anchorKey])
  @@index([entityClass])
  @@index([chain, walletAddress])
  @@map("entity_dormancy_observations")
}

/// Dormancy Task 9 — bounded strictly-pre-event funding/reactivation path per
/// anchor event (backward BFS over VALUED money-flow edges, depth <=3, nodes
/// <=50, service nodes are path TERMINALS, never expanded). Valuation stays
/// honest: unknown-value funding is reported, never treated as evidence.
/// SHADOW-ONLY analytics: never read by FlowScore/signals/eligibility.
model FundingReactivationPath {
  id                           String    @id @default(cuid())
  chain                        ChainId
  walletAddress                String
  eventKind                    String
  anchorKey                    String
  eventTs                      DateTime
  /// funded | unknown_value_funding_only | no_meaningful_pre_event_funding |
  /// no_transfer_history
  status                       String
  /// Nearest VALUED (>dust) pre-event inbound — the reactivation funding.
  directFunderAddress          String?
  directFundingTs              DateTime?
  directFundingAsset           String?
  /// HONEST valuation — NULL == unknown (never 0-for-unknown).
  directFundingValuedUsd       Decimal?  @db.Decimal(20, 4)
  directFundingTxHash          String?
  /// Earliest VALUED pre-event inbound in local history (first funder).
  firstFunderAddress           String?
  firstFundingTs               DateTime?
  firstFundingTxHash           String?
  /// eventTs - directFundingTs, seconds.
  fundingToEventDelaySec       Int?
  pathDepth                    Int       @default(0)
  nodesExplored                Int       @default(0)
  pathTruncated                Boolean   @default(false)
  /// Bounded hop list: {hop, address, fundedAddress, ts, txHash, asset, valuedUsd, serviceNode}.
  pathJson                     Json
  /// possible | probable | strong (relationship-contract bands) — funder link.
  funderRelationshipTier       String?
  funderRelationshipConfidence Float?
  /// Prior VALUED fundings from the SAME direct funder to this wallet, pre-event.
  repeatFundingCount           Int       @default(0)
  reasonCodes                  String[]
  receiptsJson                 Json
  caveats                      String[]
  engineVersion                Int
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@unique([chain, walletAddress, eventKind, anchorKey])
  @@index([status])
  @@index([directFunderAddress])
  @@map("funding_reactivation_paths")
}

/// Dormancy Task 10 — post-entry behavior per (wallet, token entry), derived
/// from the observed entry FORWARD (existing tokenPositions + receipts engine
/// + token-scoped outbound transfers). A transfer is NEVER a sale without
/// evidence: outbound token flows are labeled linked/service/unknown, not
/// exits. SHADOW-ONLY analytics.
model PostEntryBehavior {
  id                     String   @id @default(cuid())
  chain                  ChainId
  walletAddress          String
  tokenAddress           String
  entryTs                DateTime
  /// durable_hold | partial_exit | full_exit | fast_flip | fast_dump |
  /// burst_exit | staged_distribution | transfer_to_linked |
  /// transfer_to_service | still_holding | unknown
  primaryClass           String
  /// Every applicable label (a fast flip is ALSO a full exit, etc.).
  labels                 String[]
  buyCount               Int      @default(0)
  sellCount              Int      @default(0)
  exitRatio              Float?
  timeToFirstSellSec     Int?
  fullExitSec            Int?
  outboundTokenTransfers Int      @default(0)
  outboundToLinked       Int      @default(0)
  outboundToService      Int      @default(0)
  outboundUnknown        Int      @default(0)
  confidence             Float
  /// False when the local view was truncated/unpriced — honesty-degraded.
  dataComplete           Boolean  @default(false)
  reasonCodes            String[]
  receiptsJson           Json
  caveats                String[]
  engineVersion          Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([chain, walletAddress, tokenAddress])
  @@index([primaryClass])
  @@index([chain, walletAddress])
  @@map("post_entry_behaviors")
}

/// Dormancy Task 11 — repeat-runner candidate ranking per ENTITY
/// (entity-adjusted: probable/strong-linked wallets never count as
/// independent repeats). Small-N honesty: insufficient_evidence rows are the
/// expected common case. OBSERVATION-ONLY: never votes, never eligibility.
model RepeatRunnerCandidate {
  id                     String   @id @default(cuid())
  chain                  ChainId
  /// Deterministic entity key = lexicographically-smallest member wallet.
  entityKey              String
  memberWallets          String[]
  /// True when >1 member was merged via probable/strong links.
  entityAdjusted         Boolean  @default(false)
  /// candidate | insufficient_evidence | excluded_negative_evidence
  status                 String
  runnersEntered         Int      @default(0)
  distinctRunnersEntered Int      @default(0)
  controlsEntered        Int      @default(0)
  otherTokensEntered     Int      @default(0)
  /// Share of runner entries on the single top token (1.0 == one-winner).
  oneWinnerDependence    Float?
  behaviorQualityJson    Json?
  negativeEvidenceJson   Json?
  /// Observation-only ranking score (capped, receipted) — NEVER a promotion.
  score                  Float?
  scoreBasis             String[]
  reasonCodes            String[]
  receiptsJson           Json
  caveats                String[]
  engineVersion          Int
  computedAt             DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([chain, entityKey])
  @@index([status])
  @@map("repeat_runner_candidates")
}

/// Dormancy Task 12 — dormant-runner pattern per ENTITY (joins T7/T8 dormancy
/// observations with T11 exposure). A pattern is NEVER claimed from one
/// event. OBSERVATION-ONLY: never votes, never eligibility.
model DormantRunnerCandidate {
  id                         String   @id @default(cuid())
  chain                      ChainId
  entityKey                  String
  memberWallets              String[]
  /// repeated_independent_dormant | side_wallet_activation_pattern |
  /// fresh_funding_pattern | one_off | insufficient_evidence
  pattern                    String
  dormantEntryEvents         Int      @default(0)
  sideWalletActivationEvents Int      @default(0)
  freshFundingEvents         Int      @default(0)
  distinctRunnerTokens       Int      @default(0)
  /// Bounded event list: {wallet, token, eventTs, addressClass, entityClass}.
  eventsJson                 Json
  confidence                 Float
  reasonCodes                String[]
  receiptsJson               Json
  caveats                    String[]
  engineVersion              Int
  computedAt                 DateTime
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([chain, entityKey])
  @@index([pattern])
  @@map("dormant_runner_candidates")
}

/// Top-PnL discovery (runner-mining scope correction) — one candidate row per
/// (mint, wallet, source). Provider-claimed figures are DISCOVERY EVIDENCE
/// ONLY (never votes, never eligibility, never local truth); local fields are
/// bounded local reconstruction; validation compares the two honestly.
/// SHADOW-ONLY analytics.
model TokenTopPnlCandidate {
  id                      String    @id @default(cuid())
  chain                   ChainId
  mint                    String
  walletAddress           String
  /// 'local_reconstruction' | 'birdeye_top_traders'
  source                  String
  /// Provider list position (1-based) or local rank by realized proxy.
  providerRank            Int?
  claimedRealizedPnlUsd   Decimal?  @db.Decimal(24, 4)
  claimedUnrealizedPnlUsd Decimal?  @db.Decimal(24, 4)
  claimedTotalPnlUsd      Decimal?  @db.Decimal(24, 4)
  claimedBoughtUsd        Decimal?  @db.Decimal(24, 4)
  claimedSoldUsd          Decimal?  @db.Decimal(24, 4)
  /// Provider does not report remaining value — stays NULL (never derived).
  claimedRemainingUsd     Decimal?  @db.Decimal(24, 4)
  /// Only when the provider supplies enough to derive it honestly; else NULL.
  claimedRoi              Float?
  claimedTradeCount       Int?
  providerTags            String[]
  /// Provider window (24h max — a PRESENT-window view, never historical).
  providerTimeFrame       String?
  /// Verbatim provider item (receipt).
  providerJson            Json?
  localBuyCount           Int       @default(0)
  localSellCount          Int       @default(0)
  /// Sums of PRICED trades only (unpriced never fabricated as $0).
  localBoughtUsd          Decimal?  @db.Decimal(24, 4)
  localSoldUsd            Decimal?  @db.Decimal(24, 4)
  /// localSoldUsd - localBoughtUsd (rough realized proxy, priced legs only).
  localRealizedProxyUsd   Decimal?  @db.Decimal(24, 4)
  localFirstBuyTs         DateTime?
  localFirstSellTs        DateTime?
  localLastSellTs         DateTime?
  localUnpricedTrades     Int       @default(0)
  /// locally_verified | partially_verified | provider_only | conflicting |
  /// incomplete | invalid
  validation              String
  /// local_full | local_partial | none
  coverage                String
  confidence              Float
  reasonCodes             String[]
  receiptsJson            Json
  caveats                 String[]
  engineVersion           Int
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([chain, mint, walletAddress, source])
  @@index([mint])
  @@index([walletAddress])
  @@index([validation])
  @@map("token_top_pnl_candidates")
}

/// Per-mint provider fetch state for the top-PnL discovery pass — resumable
/// (fetched mints are skipped) + budgeted, mirroring token_enrichments.
model TopPnlFetchState {
  id         String    @id @default(cuid())
  chain      ChainId   @default(SOLANA)
  mint       String
  provider   String    @default("birdeye_top_traders")
  /// fetched | empty | provider_error
  status     String
  itemCount  Int       @default(0)
  retryCount Int       @default(0)
  lastError  String?
  fetchedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([chain, mint, provider])
  @@index([status])
  @@map("top_pnl_fetch_states")
}

/// Wallet DNA (runner-mining scope correction) — one OBSERVATION-ONLY row per
/// discovered wallet: complete cross-token history (winners AND losers),
/// WR/EV over COMPLETED positions only (explicit denominators; open and
/// unpriced positions never count as wins/losses), one-winner dependence
/// exposed, dormancy/funding/post-entry summaries joined from the T7-T12
/// shadow tables. Coverage-adjusted confidence. NEVER feeds FlowScore/
/// signals/eligibility; wallets stay observation_only.
model WalletDnaProfile {
  id                        String   @id @default(cuid())
  chain                     ChainId
  walletAddress             String
  /// Constant 'observation_only' — DNA rows grant nothing.
  status                    String   @default("observation_only")
  tokensEntered             Int      @default(0)
  runnersEntered            Int      @default(0)
  completedPositions        Int      @default(0)
  openPositions             Int      @default(0)
  unpricedPositions         Int      @default(0)
  winCount                  Int      @default(0)
  lossCount                 Int      @default(0)
  /// NULL when completedPositions == 0 — never a fabricated 0/0.
  winRate                   Float?
  evUsdPerCompletedPosition Float?
  oneWinnerDependence       Float?
  avgReturn                 Float?
  medianReturn              Float?
  totalRealizedPnlUsd       Decimal? @db.Decimal(24, 4)
  repeatRunnerCount         Int?
  repeatRunnerRate          Float?
  medianEntryMcapUsd        Decimal? @db.Decimal(24, 4)
  fastDumpRate              Float?
  deadRugExposureRate       Float?
  outcomeMixJson            Json?
  dormancySummaryJson       Json?
  fundingSummaryJson        Json?
  postEntryMixJson          Json?
  negativeEvidenceJson      Json?
  /// Which mints/sources discovered this wallet (receipt).
  discoveryJson             Json?
  /// full | partial | minimal
  coverage                  String
  confidence                Float
  reasonCodes               String[]
  receiptsJson              Json
  caveats                   String[]
  engineVersion             Int
  computedAt                DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([chain, walletAddress])
  @@index([coverage])
  @@map("wallet_dna_profiles")
}

/// Capital outflow path (working-loop milestone) — where capital LEAVES a
/// qualified (DNA-discovered) wallet: direct transfers, bounded multi-hop
/// transfers, bridge exits, router/service exits and CEX deposits. Evidence
/// tiers are ORDERED: direct_transfer > multi_hop_transfer > bridge_inference
/// > cex_correlation — a CEX deposit NEVER attributes a downstream receiver.
/// SHADOW-ONLY analytics; observation_only always.
model CapitalOutflowPath {
  id                       String   @id @default(cuid())
  chain                    ChainId
  /// Qualified source wallet (wallet_dna_profiles cohort).
  sourceWallet             String
  /// Entity key of the source (repeat_runner_candidates adjustment; the
  /// wallet's own address when no entity row covers it).
  sourceEntityKey          String
  destinationAddress       String
  /// wallet | bridge | cex | service
  destinationType          String
  /// direct_transfer | multi_hop_transfer | bridge_inference | cex_correlation
  evidenceTier             String
  hops                     Int
  transferCount            Int      @default(0)
  /// Sum of KNOWN (valued > dust) USD across counted legs — never a claimed
  /// total; unknown-value legs are counted separately.
  knownValueUsd            Decimal? @db.Decimal(24, 4)
  unknownValueLegs         Int      @default(0)
  firstTransferTs          DateTime
  lastTransferTs           DateTime
  bridgeProtocol           String?
  /// Pre-existing (pre-first-transfer) source<->receiver relationship tier.
  receiverRelationshipTier String?
  /// fresh_receiver | dormant_receiver | active_receiver | service | unknown
  receiverClassAtReceipt   String
  pathJson                 Json
  reasonCodes              String[]
  receiptsJson             Json
  caveats                  String[]
  engineVersion            Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([chain, sourceWallet, destinationAddress, evidenceTier])
  @@index([destinationAddress])
  @@index([sourceEntityKey])
  @@index([evidenceTier])
  @@map("capital_outflow_paths")
}

/// Receiver enrollment (working-loop milestone) — a wallet that RECEIVED
/// meaningful capital from a qualified entity via transfer evidence
/// (direct/multi-hop ONLY — bridge/CEX tiers never enroll receivers), kept
/// strictly observation_only, with its post-receipt token deployments
/// detected from local trades. PILOT/SHADOW-ONLY: never touches the live
/// monitoring machinery, never grants eligibility.
model ReceiverEnrollment {
  id                  String   @id @default(cuid())
  chain               ChainId
  receiverAddress     String
  /// Constant 'observation_only'.
  status              String   @default("observation_only")
  /// fresh_receiver | dormant_reactivated | linked_side_wallet |
  /// active_receiver | unknown
  receiverClass       String
  /// Qualified source entities that funded this receiver (bounded).
  sourceEntityKeys    String[]
  sourceWallets       String[]
  evidenceTiers       String[]
  firstReceiptTs      DateTime
  totalKnownInflowUsd Decimal? @db.Decimal(24, 4)
  unknownValueLegs    Int      @default(0)
  /// Post-receipt token BUY deployments: [{mint, firstBuyTs, buyCount,
  /// boughtKnownUsd|null, unpricedBuys}] — bounded, stable order.
  deploymentsJson     Json
  deployedTokenCount  Int      @default(0)
  reasonCodes         String[]
  receiptsJson        Json
  caveats             String[]
  engineVersion       Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([chain, receiverAddress])
  @@index([receiverClass])
  @@map("receiver_enrollments")
}

/// Automatic token-candidate row (working-loop milestone) — one row per
/// candidate mint discovered from qualified-entity + enrolled-receiver buys.
/// The state vocabulary REUSES StealthState semantics but is derived from
/// MINING evidence (stateBasis 'mining_derived'); when the live stealth
/// engine has a persisted snapshot it is recorded SIDE BY SIDE (never
/// overridden, never fabricated). The score is a SHADOW ranking (documented
/// deterministic weights) — NOT a FlowScore, NEVER feeds signals/eligibility.
model TokenCandidateScore {
  id                     String    @id @default(cuid())
  chain                  ChainId
  mint                   String
  /// Latest locally observed market cap (TokenMarketSnapshot) — NULL when
  /// never observed (never fabricated).
  currentMcapUsd         Decimal?  @db.Decimal(20, 4)
  currentMcapTs          DateTime?
  qualifiedEntityCount   Int       @default(0)
  /// Entity-adjusted count of INDEPENDENT qualified entities buying (linked
  /// wallets/receivers collapse into their source entity).
  independentEntityCount Int       @default(0)
  qualifiedBuyerCount    Int       @default(0)
  linkedAddressCount     Int       @default(0)
  receiverDeployments    Int       @default(0)
  dormantReactivations   Int       @default(0)
  fundedPathCount        Int       @default(0)
  altWalletEvidenceCount Int       @default(0)
  nonCohortBuyerCount    Int       @default(0)
  kolContamination       Int       @default(0)
  /// Post-entry behavior mix of qualified buyers ON THIS MINT.
  behaviorMixJson        Json?
  /// WATCHING | STEALTH_ACCUMULATION | EARLY_INDEPENDENT_CONFIRMATION |
  /// PUBLIC_KOL_ARRIVAL | CROWD_EXPANSION | DISTRIBUTION_RISK | INVALIDATED
  state                  String
  /// 'mining_derived' — the only basis this builder writes.
  stateBasis             String
  /// Latest persisted StealthSnapshot state for the token (side-by-side
  /// evidence; NULL when the stealth engine never evaluated it).
  stealthEngineState     String?
  stealthEngineBucketTs  DateTime?
  /// SHADOW ranking 0-100 (deterministic documented weights) — not FlowScore.
  score                  Float
  confidence             Float
  buyersJson             Json
  fundingPathsJson       Json?
  reasonCodes            String[]
  receiptsJson           Json
  caveats                String[]
  engineVersion          Int
  computedAt             DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([chain, mint])
  @@index([state])
  @@index([score])
  @@map("token_candidate_scores")
}

/// Golden cohort (product-rescue sprint) — deterministic product-validation
/// selection over the historical universe, with per-member selection
/// receipts. Not a replacement for the full resumable universe.
model GoldenCohortMember {
  id                   String   @id @default(cuid())
  chain                ChainId
  /// token | wallet | control_token
  kind                 String
  key                  String
  rank                 Int
  selectionMetricsJson Json
  reasonCodes          String[]
  engineVersion        Int
  selectedAt           DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([chain, kind, key])
  @@index([kind])
  @@map("golden_cohort_members")
}

/// No-lookahead historical replay event (product-rescue sprint): what the
/// candidate engine would have shown at eventTs using ONLY evidence at or
/// before eventTs; the later outcome is recorded SEPARATELY and never feeds
/// back into the at-event fields. SHADOW-ONLY.
model ReplaySignalEvent {
  id                          String   @id @default(cuid())
  chain                       ChainId
  mint                        String
  /// runner | control
  cohortKind                  String
  eventTs                     DateTime
  /// signal | no_signal
  eventKind                   String
  scoreAtEvent                Float
  stateAtEvent                String
  independentEntitiesAtEvent  Int      @default(0)
  buyersAtEvent               Int      @default(0)
  dormantReactivationsAtEvent Int      @default(0)
  fundedPathsAtEvent          Int      @default(0)
  kolContaminationAtEvent     Int      @default(0)
  evidenceAsOfJson            Json
  mcapAtSignalUsd             Decimal? @db.Decimal(24, 4)
  mcapH1Usd                   Decimal? @db.Decimal(24, 4)
  mcapH6Usd                   Decimal? @db.Decimal(24, 4)
  mcapH24Usd                  Decimal? @db.Decimal(24, 4)
  mcapD3Usd                   Decimal? @db.Decimal(24, 4)
  mcapD7Usd                   Decimal? @db.Decimal(24, 4)
  maxLaterMcapUsd             Decimal? @db.Decimal(24, 4)
  maxDrawdownPct              Float?
  /// true_positive | false_positive | miss | true_negative
  classification              String
  outcomeJson                 Json
  reasonCodes                 String[]
  caveats                     String[]
  engineVersion               Int
  computedAt                  DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([chain, mint, eventKind])
  @@index([classification])
  @@index([cohortKind])
  @@map("replay_signal_events")
}

/// Evidence-backed wallet role (discovery sprint) — one row per (wallet,
/// role). Roles are PROBABILISTIC on-chain relationships, never identity
/// claims; every row carries its evidence tier and receipts. SHADOW-ONLY.
model WalletRoleAssignment {
  id            String   @id @default(cuid())
  chain         ChainId
  walletAddress String
  /// execution_wallet | fresh_funded_receiver | dormant_funded_receiver |
  /// probable_side_wallet | probable_linked_wallet | bridge_linked_receiver |
  /// possible_cex_mediated_receiver | profit_collection_wallet |
  /// funding_wallet | service_router_cex_node | operator_root |
  /// unknown_related_wallet
  role          String
  /// direct_transfer | repeated_direct | bridge_inference | cex_correlation |
  /// relationship_tier | derived
  evidenceTier  String
  /// Entity this wallet is grouped under (union-find root key).
  entityKey     String?
  confidence    Float
  reasonCodes   String[]
  receiptsJson  Json
  caveats       String[]
  engineVersion Int
  computedAt    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([chain, walletAddress, role])
  @@index([role])
  @@index([entityKey])
  @@map("wallet_role_assignments")
}

/// ENTITY DNA (discovery sprint) — aggregates only sufficiently linked
/// addresses (union-find over receiver-funding links, probable/strong
/// relationship tiers, repeat-candidate membership and operator-root
/// funding) while preserving uncertainty. ADDRESS DNA stays per-wallet in
/// wallet_dna_profiles; this row is the entity-adjusted view. Ten linked
/// side wallets never count as ten independent wallets here. SHADOW-ONLY,
/// observation_only always.
model EntityDnaProfile {
  id                        String   @id @default(cuid())
  chain                     ChainId
  entityKey                 String
  memberWallets             String[]
  memberCount               Int      @default(1)
  /// Operator lineage-root address when a member is a known root.
  rootWallet                String?
  linkEvidenceJson          Json
  runnersInvolved           Int      @default(0)
  completedPositions        Int      @default(0)
  winCount                  Int      @default(0)
  lossCount                 Int      @default(0)
  unresolvedPositions       Int      @default(0)
  winRate                   Float?
  evUsdPerCompletedPosition Float?
  avgReturn                 Float?
  medianReturn              Float?
  totalRealizedPnlUsd       Decimal? @db.Decimal(24, 4)
  repeatRunnerCount         Int?
  oneWinnerDependence       Float?
  dormantReactivations      Int      @default(0)
  fundedEntries             Int      @default(0)
  stagedCapitalUsd          Decimal? @db.Decimal(24, 4)
  undeployedReceivers       Int      @default(0)
  deployedReceivers         Int      @default(0)
  coverage                  String
  confidence                Float
  reasonCodes               String[]
  receiptsJson              Json
  caveats                   String[]
  engineVersion             Int
  computedAt                DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([chain, entityKey])
  @@index([memberCount])
  @@map("entity_dna_profiles")
}

/// Per-token top-PnL extraction OUTCOME (finish-pipeline sprint) — one row per
/// verified $10M+ runner recording whether wallet discovery actually
/// SUCCEEDED, not merely that the token has a processing state. SHADOW-ONLY.
model TopPnlExtractionStatus {
  id                 String   @id @default(cuid())
  chain              ChainId
  mint               String
  /// local_reconstruction_ok | provider_ok | retryable_provider_failure |
  /// unavailable | no_valid_wallets | incomplete_coverage
  status             String
  hasTokenRow        Boolean  @default(false)
  hasLocalTrades     Boolean  @default(false)
  walletCount        Int      @default(0)
  locallyVerified    Int      @default(0)
  providerOnly       Int      @default(0)
  incomplete         Int      @default(0)
  providerFetchState String?
  reasonCodes        String[]
  receiptsJson       Json
  engineVersion      Int
  computedAt         DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([chain, mint])
  @@index([status])
  @@map("top_pnl_extraction_status")
}

/// Real capital chain (finish-pipeline sprint) — the end-to-end product
/// proof: a known/probable entity moves capital to a receiver (STAGING),
/// that receiver later buys a token (DEPLOYMENT), or profit from one token
/// rotates into another through the same/linked entity (ROTATION). Built by
/// JOINING existing evidence (outflow paths, receiver enrollments, local
/// trades) — nothing fabricated; near-empty deployment is an honest data
/// state, never faked. SHADOW-ONLY, observation_only.
model CapitalChain {
  id                         String    @id @default(cuid())
  /// Deterministic idempotency key: kind|sourceWallet|receiverWallet|tokenBought (nulls as empty).
  dedupeKey                  String    @unique
  chain                      ChainId
  /// staging | deployment | profit_rotation
  kind                       String
  sourceEntityKey            String
  sourceWallet               String
  receiverWallet             String?
  /// direct_transfer | multi_hop_transfer | same_wallet_rotation | linked_entity_rotation
  route                      String
  evidenceTier               String
  knownValueUsd              Decimal?  @db.Decimal(24, 4)
  fundingTs                  DateTime?
  /// The token the capital was deployed / rotated INTO (null for pure staging).
  tokenBought                String?
  tokenBoughtSymbol          String?
  entryMcapUsd               Decimal?  @db.Decimal(24, 4)
  fundingToBuyDelaySec       Int?
  /// The token a profit rotation came FROM (rotation only).
  sourceToken                String?
  realizedProfitUsd          Decimal?  @db.Decimal(24, 4)
  receiverClass              String?
  relationshipTier           String?
  independentEntitiesOnToken Int?
  confidence                 Float
  reasonCodes                String[]
  receiptsJson               Json
  caveats                    String[]
  engineVersion              Int
  computedAt                 DateTime
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([kind])
  @@index([tokenBought])
  @@index([sourceEntityKey])
  @@map("capital_chains")
}

/// Canonical provider-independent mass-tracker event store. Additive and
/// shadow-only: no scoring path reads this table and no field grants wallet
/// eligibility. Provider-scoped `eventId` is the replay-idempotency key.
model MassTransactionEvent {
  id                  String   @id @default(cuid())
  eventId             String   @unique
  chain               ChainId
  txHash              String
  eventIndex          Int
  blockOrSlot         BigInt
  ts                  DateTime
  kind                String
  status              String
  fromAddress         String
  toAddress           String
  actorAddress        String?
  assetAddress        String?
  assetSymbol         String?
  assetDecimals       Int?
  amountToken         String
  amountUsd           Decimal? @db.Decimal(24, 4)
  programOrContract   String?
  provider            String
  observedAt          DateTime
  bridgeProtocol      String?
  officialMessageId   String?
  bridgeJson          Json?
  relevanceCategory   String
  relevanceScore      Float
  reasonCodes         String[]
  safeEntityLink      Boolean  @default(false)
  enrollmentCandidate Boolean  @default(false)
  sourceEntityKey     String?
  sourceRole          String?
  metadataJson        Json
  createdAt           DateTime @default(now())

  @@index([chain, txHash, eventIndex])
  @@index([fromAddress, ts])
  @@index([toAddress, ts])
  @@index([actorAddress, ts])
  @@index([officialMessageId])
  @@index([sourceEntityKey, ts])
  @@index([relevanceCategory, ts])
  @@map("mass_transaction_events")
}

/// Official or explicitly-probable source->destination bridge pairing.
/// Only `verified` rows may carry an entity path across chains.
model MassBridgeCorrelation {
  id                 String   @id @default(cuid())
  correlationId      String   @unique
  protocol           String
  officialMessageId  String?
  sourceEventId      String
  destinationEventId String
  status             String
  confidence         Float
  reasonCodes        String[]
  correlatedAt       DateTime @default(now())

  @@unique([sourceEventId, destinationEventId])
  @@index([officialMessageId])
  @@index([status])
  @@map("mass_bridge_correlations")
}

/// Auditable entity->capital/bridge->receiver->token-buy proof. Shadow-only;
/// `grantsEligibility` is structurally fixed false by every writer.
model MassTrackerTrace {
  id                   String   @id @default(cuid())
  traceId              String   @unique
  sourceEntityKey      String
  sourceRole           String
  sourceWallet         String
  terminalWallet       String
  tokenBought          String
  route                String
  eventIds             String[]
  bridgeCorrelationIds String[]
  fundingToBuyDelaySec Int
  confidence           Float
  reasonCodes          String[]
  grantsEligibility    Boolean  @default(false)
  computedAt           DateTime

  @@index([sourceEntityKey, computedAt])
  @@index([tokenBought, computedAt])
  @@map("mass_tracker_traces")
}

/// One tracker execution's operational evidence. Memory is sampled after
/// every batch; retries are counted at the failing batch boundary.
model MassTrackerRun {
  id                  String    @id
  startedAt           DateTime
  completedAt         DateTime?
  status              String
  inputEvents         Int       @default(0)
  persistedEvents     Int       @default(0)
  duplicateEvents     Int       @default(0)
  relevantEvents      Int       @default(0)
  receiversEnrolled   Int       @default(0)
  bridgePairsVerified Int       @default(0)
  tracesBuilt         Int       @default(0)
  batches             Int       @default(0)
  retryAttempts       Int       @default(0)
  providerErrors      Int       @default(0)
  peakHeapBytes       BigInt    @default(0)
  throughputPerSec    Float     @default(0)
  error               String?
  metadataJson        Json

  @@index([startedAt])
  @@index([status])
  @@map("mass_tracker_runs")
}

/// Per-receiver post-receipt activity backfill result (live-recovery sprint).
/// One row per enrolled receiver recording whether a token deployment was
/// observed after its funding receipt, read from local + live-collected
/// activity. Honest terminal status per receiver. SHADOW-ONLY.
model ReceiverActivityBackfill {
  id                    String    @id @default(cuid())
  chain                 ChainId
  receiverAddress       String
  sourceEntityKey       String
  sourceWallets         String[]
  firstReceiptTs        DateTime
  backfillStart         DateTime
  backfillEnd           DateTime
  /// deployment_found | covered_no_post_receipt_buy | partial_coverage |
  /// retryable_provider_failure | unavailable | invalid
  status                String
  source                String
  hasLiveWalletRow      Boolean   @default(false)
  postReceiptTxObserved Int       @default(0)
  postReceiptEdges      Int       @default(0)
  firstActivityTs       DateTime?
  firstBuyTs            DateTime?
  firstBuyMint          String?
  fundingToBuyDelaySec  Int?
  boughtKnownUsd        Decimal?  @db.Decimal(24, 4)
  entryMcapUsd          Decimal?  @db.Decimal(24, 4)
  receiverClass         String?
  relationshipTier      String?
  reasonCodes           String[]
  receiptsJson          Json
  caveats               String[]
  engineVersion         Int
  computedAt            DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([chain, receiverAddress])
  @@index([status])
  @@map("receiver_activity_backfills")
}

/// Canonical token metadata (live-recovery sprint) — resolved name/symbol/logo
/// separate from the ingest placeholder (which stores a mint prefix). NULL
/// name/symbol means UNAVAILABLE (never a mint prefix). Bounded + resumable
/// provider fetch; availability + source labeled honestly. SHADOW-ONLY.
model TokenMetadata {
  id            String    @id @default(cuid())
  chain         ChainId
  mint          String
  name          String?
  symbol        String?
  logoUri       String?
  /// helius_das | birdeye_overview | onchain_metaplex | unavailable
  source        String
  /// resolved | placeholder_only | retryable | unavailable
  availability  String
  lastError     String?
  fetchedAt     DateTime?
  reasonCodes   String[]
  engineVersion Int
  computedAt    DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([chain, mint])
  @@index([availability])
  @@map("token_metadata")
}

/// Canonical, provider-independent historical-winner universe. One row per
/// chain/token aggregates every verified source and carries its own resumable
/// processing state. Unsupported/missing coverage is persisted, never mocked.
model HistoricalTokenUniverse {
  id                     String    @id @default(cuid())
