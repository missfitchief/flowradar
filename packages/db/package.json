{
  "name": "@flowradar/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "prisma generate",
    "db:migrate": "tsx ../../scripts/db-local.ts ensure && prisma migrate deploy",
    "db:migrate:new": "tsx ../../scripts/db-local.ts ensure && prisma migrate dev",
    "db:seed": "tsx ../../scripts/db-local.ts ensure && tsx src/seed.ts",
    "db:studio": "tsx ../../scripts/db-local.ts ensure && prisma studio",
    "backtest:replay": "tsx src/scripts/runReplay.ts"
  },
  "dependencies": {
    "@flowradar/core": "*",
    "@flowradar/providers": "*",
    "@prisma/client": "^6.19.2",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^16.14.0-beta.17",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "prisma": "^6.19.2",
    "tsx": "^4.23.0"
  }
}
