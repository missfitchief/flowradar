{
  "compilerOptions": {
    // Bumped from Next's ES2017 scaffold default (Task 16): apps/web now
    // transitively imports @flowradar/providers (POST /api/alerts/test ->
    // createTelegramSender), and packages/providers/src/mock/world.ts (Task
    // 4, pre-existing) uses BigInt literals (0n/1n) for its slot/block
    // counters — TS2737 under ES2017. This is a type-checking-only knob for
    // Next's App Router (SWC does the actual codegen per its own browserslist
    // target, unaffected by this file), and every runtime this app ships to
    // (Node 24 dev/prod server, evergreen browsers for client components)
    // natively supports ES2020, so this is a non-regressive typecheck fix,
    // not a behavior change.
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
